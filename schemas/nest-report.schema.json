{
  "$defs": {
    "Contour": {
      "description": "A closed boundary: a start point and segments that end where it began.",
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "type": "array"
        },
        "start": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "start",
        "segments"
      ],
      "type": "object"
    },
    "Coverage": {
      "description": "Arc-length coverage on one original outer contour, for reporting and for\nexcluding future lead attachment points. Intervals may wrap around length.",
      "properties": {
        "from_mm": {
          "format": "double",
          "type": "number"
        },
        "part_copy": {
          "type": "string"
        },
        "to_mm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "part_copy",
        "from_mm",
        "to_mm"
      ],
      "type": "object"
    },
    "Metrics": {
      "properties": {
        "full_stock_area": {
          "format": "double",
          "type": "number"
        },
        "last_sheet_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_sheet_used_height": {
          "description": "In the job's declared coordinate units; measured in the +Y direction.",
          "format": "double",
          "type": "number"
        },
        "material_area": {
          "format": "double",
          "type": "number"
        },
        "normalized_material": {
          "description": "Material area divided by the largest available stock outline's area.",
          "format": "double",
          "type": "number"
        },
        "placed_area": {
          "description": "Area is mm² for physical jobs, squared model units for unitless jobs.",
          "format": "double",
          "type": "number"
        },
        "placed_parts": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "placed_priority": {
          "description": "Sum of per-copy priorities, not an area-weighted score.",
          "format": "double",
          "type": "number"
        },
        "requested_parts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sheets_used": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "trailing_offcut_area": {
          "format": "double",
          "type": "number"
        },
        "utilization": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "sheets_used",
        "placed_parts",
        "requested_parts",
        "placed_area",
        "placed_priority",
        "full_stock_area",
        "material_area",
        "normalized_material",
        "utilization",
        "trailing_offcut_area",
        "last_sheet_used_height"
      ],
      "type": "object"
    },
    "Report": {
      "properties": {
        "backend": {
          "type": "string"
        },
        "maximum_outside_ratio": {
          "format": "double",
          "type": "number"
        },
        "maximum_overlap_ratio": {
          "format": "double",
          "type": "number"
        },
        "maximum_total_overlap_ratio": {
          "format": "double",
          "type": "number"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metrics"
            },
            {
              "type": "null"
            }
          ],
          "description": "Invalid layouts are never assigned a usable score."
        },
        "units": {
          "$ref": "#/$defs/Units"
        },
        "valid": {
          "type": "boolean"
        },
        "violation_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "violations": {
          "description": "At most 128 diagnostics; violation_count includes every detected failure.",
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "type": "array"
        }
      },
      "required": [
        "valid",
        "backend",
        "units",
        "maximum_overlap_ratio",
        "maximum_total_overlap_ratio",
        "maximum_outside_ratio",
        "violation_count",
        "violations"
      ],
      "type": "object"
    },
    "Report2": {
      "properties": {
        "collinearity_tolerance_mm": {
          "format": "double",
          "type": "number"
        },
        "contours_without_common": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "cut_length_with_common_mm": {
          "format": "double",
          "type": "number"
        },
        "cut_length_without_common_mm": {
          "format": "double",
          "type": "number"
        },
        "kerf_mm": {
          "format": "double",
          "type": "number"
        },
        "minimum_shared_length_mm": {
          "format": "double",
          "type": "number"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/Contour"
          },
          "type": "array"
        },
        "paths_with_common": {
          "description": "Unshared source path pieces plus COMMON paths. Closed CUT reference\ncontours remain in the export and are not an extra cutting pass.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "saved_fraction": {
          "format": "double",
          "type": "number"
        },
        "saved_length_mm": {
          "format": "double",
          "type": "number"
        },
        "shared_edges": {
          "items": {
            "$ref": "#/$defs/SharedEdge"
          },
          "type": "array"
        },
        "shared_length_mm": {
          "format": "double",
          "type": "number"
        },
        "sheet_id": {
          "type": "string"
        }
      },
      "required": [
        "sheet_id",
        "kerf_mm",
        "collinearity_tolerance_mm",
        "minimum_shared_length_mm",
        "shared_edges",
        "paths",
        "shared_length_mm",
        "cut_length_without_common_mm",
        "cut_length_with_common_mm",
        "saved_length_mm",
        "saved_fraction",
        "contours_without_common",
        "paths_with_common"
      ],
      "type": "object"
    },
    "Segment": {
      "description": "One boundary segment, always in millimetres or the job's declared units.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "line",
              "type": "string"
            },
            "to": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "Elliptical arc in centre form: `center + R(rotation) (rx cos t, ry sin t)`\nfor `t` from `start` to `start + sweep` (radians; positive is\ncounter-clockwise in a Y-up frame).",
          "properties": {
            "center": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "radii": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "rotation": {
              "format": "double",
              "type": "number"
            },
            "start": {
              "format": "double",
              "type": "number"
            },
            "sweep": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radii",
            "rotation",
            "start",
            "sweep"
          ],
          "type": "object"
        },
        {
          "properties": {
            "control": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "quad",
              "type": "string"
            },
            "to": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "control",
            "to"
          ],
          "type": "object"
        },
        {
          "properties": {
            "controls": {
              "items": {
                "items": {
                  "format": "double",
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "cubic",
              "type": "string"
            },
            "to": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "controls",
            "to"
          ],
          "type": "object"
        }
      ]
    },
    "SharedEdge": {
      "properties": {
        "from_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "maximum_offset_difference_mm": {
          "description": "Distance to the other edge's half-kerf offset, bounded by COLLINEAR_MM.",
          "format": "double",
          "type": "number"
        },
        "owners": {
          "items": {
            "$ref": "#/$defs/Coverage"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "to_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "from_mm",
        "to_mm",
        "owners",
        "maximum_offset_difference_mm"
      ],
      "type": "object"
    },
    "Units": {
      "enum": [
        "mm",
        "inch",
        "unitless"
      ],
      "type": "string"
    },
    "Violation": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The `report.json` written beside `job.json` and `layout.json` by the CLI and\nthe MCP server's `nest`.",
  "properties": {
    "algorithm": {
      "type": "string"
    },
    "common_line": {
      "items": {
        "$ref": "#/$defs/Report2"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "elapsed_s": {
      "format": "double",
      "type": "number"
    },
    "files": {
      "description": "Exported sheets, relative to the report's directory.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "parts_in_holes": {
      "description": "Copies placed inside the holes of other parts.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "repeatable": {
      "description": "Whether the same inputs and seed reproduce this layout exactly: true\nonly for a deterministic work budget that finished before the real-time\nlimit.",
      "type": "boolean"
    },
    "seed": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "time_budget_s": {
      "format": "double",
      "type": "number"
    },
    "unsupported": {
      "description": "Why the fixed-sheet search did not apply; the general search ran instead.",
      "type": [
        "string",
        "null"
      ]
    },
    "validation": {
      "$ref": "#/$defs/Report"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "work_version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "algorithm",
    "seed",
    "time_budget_s",
    "elapsed_s",
    "repeatable",
    "work_version",
    "parts_in_holes",
    "files",
    "validation"
  ],
  "title": "NestReport",
  "type": "object"
}
