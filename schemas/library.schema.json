{
  "$defs": {
    "Channel": {
      "properties": {
        "entities": {
          "description": "Expanded entity instances, including ignored entities; INSERT counts too.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "geometry_entities": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "selected_entities": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "entities",
        "geometry_entities",
        "selected_entities"
      ],
      "type": "object"
    },
    "Cleanup": {
      "properties": {
        "closed_path_overlaps_preserved": {
          "description": "Overlapping segment pairs retained because merging/removing a retraced\nedge inside a closed path would disconnect its neighbouring curves.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "duplicate_segments_removed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "overlapping_segments_merged": {
          "description": "Each redundant line merged into the union counts once.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "zero_length_segments_removed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "duplicate_segments_removed",
        "zero_length_segments_removed",
        "overlapping_segments_merged"
      ],
      "type": "object"
    },
    "Contour": {
      "description": "A closed boundary: a start point and segments that end where it began.",
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "type": "array"
        },
        "start": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "start",
        "segments"
      ],
      "type": "object"
    },
    "FileImportReport": {
      "properties": {
        "file": {
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/ImportReport"
        }
      },
      "required": [
        "file",
        "report"
      ],
      "type": "object"
    },
    "Gap": {
      "properties": {
        "from_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "size_mm": {
          "format": "double",
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "to_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "source",
        "from_mm",
        "to_mm",
        "size_mm"
      ],
      "type": "object"
    },
    "ImportReport": {
      "properties": {
        "cleanup": {
          "$ref": "#/$defs/Cleanup",
          "default": {
            "duplicate_segments_removed": 0,
            "overlapping_segments_merged": 0,
            "zero_length_segments_removed": 0
          }
        },
        "close_gaps_mm": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "closed_gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "type": "array"
        },
        "colors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Channel"
          },
          "type": "array"
        },
        "layers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Channel"
          },
          "type": "array"
        },
        "open_contours": {
          "items": {
            "$ref": "#/$defs/OpenContour"
          },
          "type": "array"
        },
        "selection_mode": {
          "default": "",
          "type": "string"
        },
        "silent_join_mm": {
          "format": "double",
          "type": "number"
        },
        "units": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "silent_join_mm",
        "closed_gaps",
        "open_contours"
      ],
      "type": "object"
    },
    "Layer": {
      "properties": {
        "cuts": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "image": {
          "type": "boolean"
        },
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kerf_mm": {
          "format": "double",
          "type": "number"
        },
        "mode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "image",
        "name",
        "mode",
        "output",
        "hidden",
        "cuts",
        "kerf_mm"
      ],
      "type": "object"
    },
    "LibraryPart": {
      "additionalProperties": false,
      "properties": {
        "area_mm2": {
          "format": "double",
          "type": "number"
        },
        "bounds_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "components": {
          "description": "All collision components of a rigid unit. Empty for legacy single-part\nlibraries, whose geometry is the polygon field above.",
          "items": {
            "$ref": "#/$defs/Polygon"
          },
          "type": "array"
        },
        "holes": {
          "items": {
            "$ref": "#/$defs/Contour"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "outer": {
          "$ref": "#/$defs/Contour"
        },
        "polygon": {
          "$ref": "#/$defs/Polygon"
        },
        "source": {
          "description": "Source file and element, layer or block.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "outer",
        "holes",
        "polygon",
        "area_mm2",
        "bounds_mm"
      ],
      "type": "object"
    },
    "LightBurnProject": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "fixed_top_level": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "type": "array"
        },
        "mirror_x": {
          "type": "boolean"
        },
        "mirror_y": {
          "type": "boolean"
        },
        "unit_ids": {
          "description": "Unit index -> library part id. Requests choose quantities and rotations.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "xml": {
          "description": "Complete original XML, including editable text and embedded image data.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "xml",
        "unit_ids",
        "layers",
        "fixed_top_level",
        "mirror_x",
        "mirror_y"
      ],
      "type": "object"
    },
    "OpenContour": {
      "properties": {
        "end_gap_mm": {
          "format": "double",
          "type": "number"
        },
        "end_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "start_mm": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "suggested_close_gaps_mm": {
          "description": "None means the endpoints exceed the 1 mm automatic repair limit.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "start_mm",
        "end_mm",
        "end_gap_mm"
      ],
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {
        "holes": {
          "default": [],
          "items": {
            "items": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        },
        "outer": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "outer"
      ],
      "type": "object"
    },
    "Segment": {
      "description": "One boundary segment, always in millimetres or the job's declared units.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "line",
              "type": "string"
            },
            "to": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "Elliptical arc in centre form: `center + R(rotation) (rx cos t, ry sin t)`\nfor `t` from `start` to `start + sweep` (radians; positive is\ncounter-clockwise in a Y-up frame).",
          "properties": {
            "center": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "radii": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "rotation": {
              "format": "double",
              "type": "number"
            },
            "start": {
              "format": "double",
              "type": "number"
            },
            "sweep": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radii",
            "rotation",
            "start",
            "sweep"
          ],
          "type": "object"
        },
        {
          "properties": {
            "control": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "quad",
              "type": "string"
            },
            "to": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "control",
            "to"
          ],
          "type": "object"
        },
        {
          "properties": {
            "controls": {
              "items": {
                "items": {
                  "format": "double",
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "cubic",
              "type": "string"
            },
            "to": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "controls",
            "to"
          ],
          "type": "object"
        }
      ]
    },
    "SheetOutline": {
      "additionalProperties": false,
      "properties": {
        "height_mm": {
          "format": "double",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "origin_mm": {
          "description": "Lower-left corner in the drawing's mm, Y-up frame, before normalization.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "outline_mm": {
          "items": {
            "$ref": "#/$defs/Polygon"
          },
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "tolerance_mm": {
          "format": "double",
          "type": "number"
        },
        "width_mm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "source",
        "width_mm",
        "height_mm",
        "origin_mm",
        "outline_mm",
        "tolerance_mm"
      ],
      "type": "object"
    },
    "UnitReport": {
      "properties": {
        "declared": {
          "type": "boolean"
        },
        "largest_dimension_in_drawing_units": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mm_per_unit": {
          "format": "double",
          "type": "number"
        },
        "possible_inches": {
          "type": "boolean"
        }
      },
      "required": [
        "declared",
        "mm_per_unit",
        "possible_inches"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Imported parts in millimetres, with the tolerance of their polygons.",
  "properties": {
    "imports": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FileImportReport"
      },
      "type": "array"
    },
    "lightburn": {
      "anyOf": [
        {
          "$ref": "#/$defs/LightBurnProject"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original editable project, used for preserving LightBurn exports."
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/LibraryPart"
      },
      "type": "array"
    },
    "sheet_outlines": {
      "description": "Stock outlines are separate from cutting parts and never nested as parts\nmerely because they were discovered on a SHEET layer.",
      "items": {
        "$ref": "#/$defs/SheetOutline"
      },
      "type": "array"
    },
    "tolerance": {
      "description": "Maximum distance between each exact curve and its polygon, in mm.",
      "format": "double",
      "type": "number"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "version",
    "tolerance",
    "parts",
    "warnings"
  ],
  "title": "Library",
  "type": "object"
}
