{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nestbolt",
  "displayName": "Nestbolt sheet nesting",
  "version": "0.1.0",
  "description": "Free nesting for laser, CNC, plasma, waterjet, fabric and leather cutting: fit SVG and DXF parts on fixed sheets to use the least material. Local, no account, nothing uploaded.",
  "author": {
    "name": "skulitom",
    "url": "https://github.com/skulitom"
  },
  "homepage": "https://github.com/skulitom/Nestbolt#readme",
  "repository": "https://github.com/skulitom/Nestbolt",
  "license": "MIT",
  "keywords": [
    "nesting",
    "sheet-nesting",
    "laser-cutting",
    "cnc",
    "plasma-cutting",
    "waterjet",
    "svg",
    "dxf",
    "material-saving",
    "mcp"
  ],
  "mcpServers": {
    "nestbolt": {
      "command": "nestbolt-mcp"
    }
  }
}
