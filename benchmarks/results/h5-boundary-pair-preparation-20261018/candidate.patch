+// Reserve the first choice in the appropriate existing pair list for the
+// two highest-ranked source members. Keep nearby alternatives, remove the
+// equivalent pair in either anchor order, and retain the original six cap.
+// The caller restores each selected pair's original member frame afterwards.
+fn include_boundary_pair(
+    layout: &JLayout,
+    keys: &[PItemKey],
+    same: &mut Vec<Vec<PItemKey>>,
+    mixed: &mut Vec<Vec<PItemKey>>,
+) {
+    let [a, b, ..] = keys else {
+        return;
+    };
+    let pairs = if std::sync::Arc::ptr_eq(
+        layout.placed_items()[*a].item(),
+        layout.placed_items()[*b].item(),
+    ) {
+        same
+    } else {
+        mixed
+    };
+    pairs.retain(|pair| !(pair.len() == 2 && pair.contains(a) && pair.contains(b)));
+    pairs.insert(0, vec![*a, *b]);
+    pairs.truncate(6);
 }
 
