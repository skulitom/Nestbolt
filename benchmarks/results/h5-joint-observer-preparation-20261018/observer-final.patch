+// Diagnostic-only observer: pure serialization and Instant reads. No search
+// clock reads, work charges, RNG calls, geometry changes or decision changes.
+thread_local! {
+    static JOINT_DIAG_PARENT: std::cell::Cell<Option<u64>> = const { std::cell::Cell::new(None) };
+}
+static JOINT_DIAG_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+struct JointDiag {
+    id: u64,
+    parent: Option<u64>,
+    kind: &'static str,
+    started: Instant,
+    data: serde_json::Value,
+    events: Vec<serde_json::Value>,
+    outcome: &'static str,
+}
+impl JointDiag {
+    fn new(kind: &'static str, data: serde_json::Value) -> Self {
+        let id = JOINT_DIAG_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let parent = JOINT_DIAG_PARENT.with(|p| p.replace(Some(id)));
+        Self {
+            id,
+            parent,
+            kind,
+            started: Instant::now(),
+            data,
+            events: vec![],
+            outcome: "unresolved",
+        }
+    }
+    fn event(&mut self, stage: &'static str, data: serde_json::Value) {
+        self.events.push(serde_json::json!({"stage":stage,"elapsed_seconds":self.started.elapsed().as_secs_f64(),"data":data}));
+    }
+}
+impl Drop for JointDiag {
+    fn drop(&mut self) {
+        JOINT_DIAG_PARENT.with(|p| p.set(self.parent));
+        eprintln!(
+            "JOINT_DIAG {}",
+            serde_json::json!({"id":self.id,"parent":self.parent,"kind":self.kind,
+            "elapsed_seconds":self.started.elapsed().as_secs_f64(),"data":self.data,"events":self.events,"outcome":self.outcome})
+        );
+    }
+}
+fn joint_diag_event(trace: &mut Option<JointDiag>, stage: &'static str, data: serde_json::Value) {
+    if let Some(trace) = trace {
+        trace.event(stage, data);
+    }
+}
+fn joint_diag_end(trace: &mut Option<JointDiag>, outcome: &'static str) {
+    if let Some(trace) = trace {
+        trace.outcome = outcome;
+    }
+}
+fn joint_diag_single(strip: &Strip, layout: &JLayout) -> serde_json::Value {
+    serde_json::json!(
+        layout
+            .placed_items()
+            .values()
+            .map(|p| {
+                let item = p.item().idx();
+                serde_json::json!({"part_id":strip.model.job.parts[strip.model.part[item]].id,
+            "transform":strip.model.external(item,&p.d_transf())})
+            })
+            .collect::<Vec<_>>()
+    )
+}
+fn joint_diag_window(strip: &Strip, layout: &JLayout) -> serde_json::Value {
+    serde_json::json!(layout.placed_items().values().filter(|p| !strip.is_blocker(p)).map(|p| {
+        let item=p.item().idx();let sheet=strip.sheet_of(p.shape());
+        serde_json::json!({"part_id":strip.model.job.parts[strip.model.part[item]].id,"active_sheet":sheet,
+            "transform":strip.model.external(item,&shift(p.d_transf(),-strip.start(sheet)))})
+    }).collect::<Vec<_>>())
+}
 
