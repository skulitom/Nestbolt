+        assert!(!exact_physical_state(before,&after));
+        let mut after=JLayout::new(other_sheets[1].layout().container().clone());
+        for q in before.placed_items().values(){after.place_item(q.item(),q.d_transf());}
+        assert!(!exact_physical_state(before,&after));
