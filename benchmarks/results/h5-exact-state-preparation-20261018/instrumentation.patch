+    // BEGIN exact-state observation tests
+    #[test]
+    fn exact_state_ignores_order_and_keys_but_retains_multiplicity() {
+        let (job, layout) = balanced_fixture();
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let before = sheets[1].layout();
+        let mut after = JLayout::new(before.container().clone());
+        let parts: Vec<_> = before.placed_items().values().collect();
+        let dummy = after.place_item(parts[0].item(), parts[0].d_transf());
+        after.remove_item(dummy);
+        for p in parts.iter().rev() { after.place_item(p.item(), p.d_transf()); }
+        assert!(exact_physical_state(before, &JLayout::from_snapshot(&before.save())));
+        assert!(exact_physical_state(before, &after));
+        assert_ne!(before.placed_items().keys().collect::<Vec<_>>(), after.placed_items().keys().collect::<Vec<_>>());
+        let key = after.place_item(parts[0].item(), parts[0].d_transf());
+        assert!(!exact_physical_state(before, &after));
+        after.remove_item(key);
+        let key = after.placed_items().keys().next().unwrap();
+        after.remove_item(key);
+        assert!(!exact_physical_state(before, &after));
+    }
+
+    #[test]
+    fn exact_state_rejects_one_ulp_rotation_reflection_and_changed_distribution() {
+        let (job, layout) = balanced_fixture();
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let before = sheets[1].layout();
+        let (key, p) = before.placed_items().iter().find(|(_,p)|p.item().area()==1350.0).unwrap();
+        let pose = p.d_transf(); let (x,y) = pose.translation();
+        for changed in [
+            DTransformation::new(pose.rotation(), (f32::from_bits(x.to_bits()+1),y)).with_reflection(pose.reflected),
+            DTransformation::new(pose.rotation(), (x,f32::from_bits(y.to_bits()+1))).with_reflection(pose.reflected),
+            DTransformation::new(pose.rotation()+0.01, (x,y)).with_reflection(pose.reflected),
+            DTransformation::new(pose.rotation(), (x,y)).with_reflection(!pose.reflected),
+        ] {
+            let mut after=JLayout::from_snapshot(&before.save());
+            after.remove_item(key);after.place_item(p.item(),changed);
+            assert!(!exact_physical_state(before,&after));
+        }
+        let mut after=JLayout::from_snapshot(&before.save());
+        let same: Vec<_> = before.placed_items().iter().filter(|(_,q)|std::sync::Arc::ptr_eq(p.item(),q.item())).collect();
+        assert_eq!(same.len(),2);
+        after.remove_item(same[1].0);after.place_item(p.item(),pose);
+        assert_eq!(before.placed_items().len(),after.placed_items().len());
+        assert!(!exact_physical_state(before,&after));
+    }
+
