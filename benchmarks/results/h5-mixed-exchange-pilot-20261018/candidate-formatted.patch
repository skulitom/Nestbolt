+    #[test]
+    fn mixed_pair_checks_each_members_rotation_and_reflection() {
+        let (mut job, layout) = mixed_fixture();
+        for permit_second in [false, true] {
+            for part in &mut job.parts {
+                if part.id == "short-incoming" || part.id == "tall-incoming" {
+                    let permits = part.id == "short-incoming" || permit_second;
+                    part.rotations = Rotations::List {
+                        degrees: if permits { vec![0.0, 90.0] } else { vec![0.0] },
+                    };
+                    part.allow_mirror = permits;
+                }
+            }
+            let model = Model::new(&job).unwrap();
+            let sheets = model.sheets_of(&layout).unwrap();
+            let mut members: Vec<_> = sheets[1]
+                .layout()
+                .placed_items()
+                .iter()
+                .filter(|(_, p)| p.item().area() < 2000.0)
+                .map(|(key, p)| (key, p.item().clone(), p.d_transf()))
+                .collect();
+            members.sort_by(|a, b| a.1.area().total_cmp(&b.1.area()));
+            assert_eq!(members.len(), 2);
+            assert!(!std::sync::Arc::ptr_eq(&members[0].1, &members[1].1));
+            let old = members[0].2;
+            let quarter =
+                DTransformation::new(old.rotation() + std::f32::consts::FRAC_PI_2, (0.0, 0.0))
+                    .with_reflection(old.reflected);
+            assert_eq!(
+                incoming_group_poses(&members, quarter).is_some(),
+                permit_second
+            );
+            let reflected = model.internal(
+                members[0].1.idx(),
+                &RigidTransform {
+                    translation: [32.0, 2.0],
+                    rotation_radians: 0.0,
+                    mirrored: true,
+                },
+            );
+            assert_eq!(
+                incoming_group_poses(&members, reflected).is_some(),
+                permit_second
+            );
+            let translated = incoming_group_poses(
+                &members,
+                DTransformation::new(old.rotation(), (4.0, 5.0)).with_reflection(old.reflected),
+            )
+            .unwrap();
+            let old_delta = (
+                members[1].2.translation().0 - old.translation().0,
+                members[1].2.translation().1 - old.translation().1,
+            );
+            let new_delta = (
+                translated[1].translation().0 - translated[0].translation().0,
+                translated[1].translation().1 - translated[0].translation().1,
+            );
+            assert!(
+                (old_delta.0 - new_delta.0).abs() < 0.0001
+                    && (old_delta.1 - new_delta.1).abs() < 0.0001
+            );
+        }
+    }
