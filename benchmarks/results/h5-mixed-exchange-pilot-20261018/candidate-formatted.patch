+    #[test]
+    fn mixed_pair_selection_is_bounded_unique_and_reaches_singletons() {
+        let (job, layout) = mixed_fixture();
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let source = sheets[1].layout();
+        let mut keys: Vec<_> = source.placed_items().keys().collect();
+        keys.sort_by(|a, b| {
+            source.placed_items()[*b]
+                .item()
+                .area()
+                .total_cmp(&source.placed_items()[*a].item().area())
+        });
+        let pairs = mixed_incoming_pairs(source, &keys);
+        assert_eq!(pairs.len(), 3);
+        assert_eq!(pairs, mixed_incoming_pairs(source, &keys));
+        assert!(pairs.iter().any(|p| p.contains(&keys[0])));
+        assert!(
+            pairs
+                .iter()
+                .any(|p| p.contains(&keys[1]) && p.contains(&keys[2]))
+        );
+        for (i, pair) in pairs.iter().enumerate() {
+            assert_ne!(pair[0], pair[1]);
+            assert!(!pairs[..i].contains(pair));
+            assert!(!std::sync::Arc::ptr_eq(
+                source.placed_items()[pair[0]].item(),
+                source.placed_items()[pair[1]].item()
+            ));
+        }
+        let mut many = JLayout::new(source.container().clone());
+        let mut many_keys = Vec::new();
+        for (family, key) in keys.iter().enumerate() {
+            for copy in 0..20 {
+                many_keys.push(many.place_item(
+                    source.placed_items()[*key].item(),
+                    DTransformation::new(0.0, (copy as f32 * 500.0, family as f32 * 10000.0)),
+                ));
+            }
+        }
+        let pairs = mixed_incoming_pairs(&many, &many_keys);
+        assert_eq!(pairs.len(), 6);
+        assert_eq!(pairs, mixed_incoming_pairs(&many, &many_keys));
+        for (i, pair) in pairs.iter().enumerate() {
+            assert!(!pairs[..i].contains(pair));
+        }
+        assert!(mixed_incoming_pairs(&many, &many_keys[..20]).is_empty());
+    }
