+// Use the existing fitted bounds, with the original crop as a hard upper limit.
+// Charge this additional scan; its caller retains the absolute phase deadline.
+fn source_frontier_target(strip: &Strip, source: &JLayout, original: f32) -> f32 {
+    if source.placed_items().is_empty() {
+        return original;
+    }
+    strip
+        .clock
+        .charge(Work::RegisteredItem, source.placed_items().len() as f64);
+    strip
+        .fit_last(
+            source,
+            Shape {
+                sheets: 1,
+                last: original,
+            },
+        )
+        .min(original)
 }
 
