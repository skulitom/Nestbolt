+    fn free_return_public(model: &Model, before: &Layout, source: &JLayout, sheet: &str) -> Layout {
+        let mut after = before.clone();
+        after.placements.retain(|p| p.sheet_id != sheet);
+        let mut copies = std::collections::BTreeMap::<String, u32>::new();
+        for p in &after.placements {
+            *copies.entry(p.part_id.clone()).or_default() += 1;
+        }
+        for p in source.placed_items().values() {
+            let id = model.job.parts[model.part[p.item().idx()]].id.clone();
+            let copy = copies.entry(id.clone()).or_default();
+            after.placements.push(Placement {
+                part_id: id,
+                copy_index: *copy,
+                sheet_id: sheet.into(),
+                transform: model.external(p.item().idx(), &p.d_transf()),
+            });
+            *copy += 1;
+        }
+        after
+    }
+
+    #[test]
+    fn free_return_finds_lower_clear_positions_sequentially_and_preserves_inventory() {
+        let (job, layout) = boundary_pair_fixture(false);
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let original = sheets[1].layout();
+        let members = return_seed_members(original);
+        let mut source = JLayout::from_snapshot(&original.save());
+        for (key, _, _) in &members {
+            source.remove_item(*key);
+        }
+        let clock = Clock::new(Timing::Work, 120.0);
+        let mut poses = vec![];
+        for (_, item, seed) in &members {
+            let pose = free_return_pose(&source, item, *seed, &clock, 10.0);
+            assert!(
+                pose.translation().0 < seed.translation().0 - 20.0,
+                "Returned part must use a lower clear space"
+            );
+            assert_eq!(pose.rotation().to_bits(), seed.rotation().to_bits());
+            assert_eq!(pose.reflected, seed.reflected);
+            let mut shape = item.shape_cd().as_ref().clone();
+            shape.transform_from(item.shape_cd(), &pose.compose());
+            assert!(!source.cde().detect_poly_collision(&shape, &NoFilter));
+            source.place_item(item, pose);
+            poses.push(pose);
+        }
+        assert_eq!(source.placed_items().len(), original.placed_items().len());
+        assert!(clock.counts().evaluations > 2.0 && clock.counts().evaluations <= 514.0);
+        assert!(clock.counts().evaluated_vertices > 0.0);
+        let after = free_return_public(&model, &model.to_layout(&sheets), &source, "sheet-1");
+        assert!(validate(&job, &after).unwrap().valid);
+        let replay_clock = Clock::new(Timing::Work, 120.0);
+        let mut replay = JLayout::from_snapshot(&original.save());
+        for (key, _, _) in &members {
+            replay.remove_item(*key);
+        }
+        for ((_, item, seed), expected) in members.iter().zip(&poses) {
+            let actual = free_return_pose(&replay, item, *seed, &replay_clock, 10.0);
+            assert_eq!(
+                return_seed_pose_bits(&[actual]),
+                return_seed_pose_bits(&[*expected])
+            );
+            replay.place_item(item, actual);
+        }
+        assert_eq!(clock.work(), replay_clock.work());
+        eprintln!(
+            "FREE_RETURN_WITNESS {}",
+            serde_json::json!({"job":job,"before":model.to_layout(&sheets),"after":after,"work":clock.counts()})
+        );
+    }
+
+    #[test]
+    fn free_return_preserves_permitted_mixed_rotations_and_mirrors() {
+        let (mut job, layout) = boundary_pair_fixture(true);
+        for part in &mut job.parts {
+            part.allow_mirror = true;
+            part.rotations = Rotations::List {
+                degrees: vec![0.0, 90.0, 180.0, 270.0],
+            };
+        }
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let members = return_seed_members(sheets[1].layout());
+        assert!(!std::sync::Arc::ptr_eq(&members[0].1, &members[1].1));
+        let mut source = JLayout::from_snapshot(&sheets[1].layout().save());
+        for (key, _, _) in &members {
+            source.remove_item(*key);
+        }
+        let clock = Clock::new(Timing::Work, 120.0);
+        for (index, (_, item, seed)) in members.iter().enumerate() {
+            let seed = DTransformation::new(
+                index as f32 * std::f32::consts::FRAC_PI_2,
+                seed.translation(),
+            )
+            .with_reflection(index == 0);
+            assert!(item.allowed_orientations().allows(&seed));
+            let pose = free_return_pose(&source, item, seed, &clock, 10.0);
+            assert!(
+                pose.translation().0 < seed.translation().0 - 20.0,
+                "Mixed return must find lower space"
+            );
+            assert_eq!(pose.rotation().to_bits(), seed.rotation().to_bits());
+            assert_eq!(pose.reflected, seed.reflected);
+            assert!(item.allowed_orientations().allows(&pose));
+            source.place_item(item, pose);
+        }
+        let after = free_return_public(&model, &model.to_layout(&sheets), &source, "sheet-1");
+        assert!(validate(&job, &after).unwrap().valid);
+        eprintln!(
+            "FREE_RETURN_WITNESS {}",
+            serde_json::json!({"job":job,"before":model.to_layout(&sheets),"after":after,"work":clock.counts()})
+        );
+    }
