+    // BEGIN free-return tests
+    // These equal-inventory fixtures can improve after lower free-space seeds.
+    // Compare against the exact internal incumbent, not authored f64 positions.
+    fn assert_free_return_outcome(
+        job: &Job,
+        before: &Layout,
+        after: &Layout,
+        moved: usize,
+        stats: &Stats,
+        enabled: bool,
+        expired: bool,
+    ) {
+        let canonical = before;
+        let baseline = validate(job, canonical).unwrap();
+        let result = validate(job, after).unwrap();
+        assert!(baseline.valid && result.valid);
+        assert!(moved <= 1);
+        assert_eq!(moved as u64, stats.directed_exchanges);
+        if moved == 0 {
+            assert_eq!(
+                serde_json::to_value(after).unwrap(),
+                serde_json::to_value(canonical).unwrap()
+            );
+        } else {
+            assert!(enabled && !expired);
+            let a = baseline.metrics.unwrap();
+            let b = result.metrics.unwrap();
+            assert!(
+                b.sheets_used <= a.sheets_used && b.material_area < a.material_area,
+                "Every accepted replacement needs strict material improvement"
+            );
+        }
+        if !enabled || expired {
+            assert_eq!(moved, 0);
+            assert_eq!(stats.directed_exchange_attempts, 0);
+        }
+    }
