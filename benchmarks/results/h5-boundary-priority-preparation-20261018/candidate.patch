+    // BEGIN boundary-priority tests
+    fn boundary_priority_fixture() -> (Job, Layout) {
+        let (mut job, mut layout) = fixture();
+        job.name = "Boundary priority witness".into();
+        job.parts = vec![
+            rectangle("anchor", 94.0, 94.0),
+            rectangle("large", 40.0, 20.0),
+            rectangle("wide", 20.0, 5.0),
+            rectangle("small", 5.0, 5.0),
+        ];
+        job.parts[1].quantity = 2;
+        job.parts[3].quantity = 2;
+        layout.placements = [
+            ("anchor", 0, 0, [2.0, 2.0]),
+            ("large", 0, 1, [2.0, 10.0]),
+            ("large", 1, 1, [47.0, 10.0]),
+            ("wide", 0, 1, [2.0, 80.0]),
+            ("small", 0, 1, [40.0, 80.0]),
+            ("small", 1, 1, [50.0, 80.0]),
+        ]
+        .into_iter()
+        .map(|(id, copy_index, sheet, translation)| Placement {
+            part_id: id.into(),
+            copy_index,
+            sheet_id: format!("sheet-{sheet}"),
+            transform: RigidTransform {
+                translation,
+                ..Default::default()
+            },
+        })
+        .collect();
+        assert!(validate(&job, &layout).unwrap().valid);
+        (job, layout)
+    }
+
+    #[test]
+    fn boundary_priority_prefers_high_small_parts_over_low_large_parts() {
+        let (job, layout) = boundary_priority_fixture();
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let source = sheets[1].layout();
+        let mut keys: Vec<_> = source.placed_items().keys().collect();
+        let before = keys.clone();
+        rank_incoming(source, &mut keys);
+        let names: Vec<_> = keys
+            .iter()
+            .map(|k| {
+                job.parts[model.part[source.placed_items()[*k].item().idx()]]
+                    .id
+                    .as_str()
+            })
+            .collect();
+        eprintln!(
+            "BOUNDARY_ORDER_WITNESS {}",
+            serde_json::json!({"job":job,"layout":layout,"names":names})
+        );
+        assert_eq!(
+            names,
+            vec!["wide", "small", "small", "large", "large"],
+            "Boundary parts must precede larger interior parts"
+        );
+        let mut a = before;
+        let mut b = keys;
+        a.sort();
+        b.sort();
+        assert_eq!(a, b);
+    }
+
+    #[test]
+    fn boundary_priority_preserves_equal_extent_area_ties() {
+        let (job, layout) = boundary_priority_fixture();
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let source = sheets[1].layout();
+        let mut keys: Vec<_> = source
+            .placed_items()
+            .iter()
+            .filter(|(_, p)| job.parts[model.part[p.item().idx()]].id == "small")
+            .map(|(k, _)| k)
+            .collect();
+        assert_eq!(keys.len(), 2);
+        keys.reverse();
+        let before = keys.clone();
+        let a = &source.placed_items()[keys[0]];
+        let b = &source.placed_items()[keys[1]];
+        assert_eq!(a.shape().bbox().x_max, b.shape().bbox().x_max);
+        assert_eq!(a.item().area(), b.item().area());
+        rank_incoming(source, &mut keys);
+        assert_eq!(
+            keys, before,
+            "Equal boundary/area ties must retain their input order"
+        );
+    }
+
