 use jagua_rs::entities::Item;
 use jagua_rs::geometry::geo_traits::TransformableFrom;
 use material_profile::material_profile;
+
+// In the rotated strip frame, rightmost extent is original sheet height.
+// Reach boundary parts before larger interior parts; equal geometry/area ties
+// retain their input order. This changes proposal order, never acceptance.
+fn rank_incoming(layout: &JLayout, keys: &mut [PItemKey]) {
+    keys.sort_by(|&a, &b| {
+        let a = &layout.placed_items()[a];
+        let b = &layout.placed_items()[b];
+        b.shape()
+            .bbox()
+            .x_max
+            .total_cmp(&a.shape().bbox().x_max)
+            .then_with(|| b.item().area().total_cmp(&a.item().area()))
+    });
+}
+
+// Priority selects which members are considered. The original area/stable
+// order still defines the anchor and relative frame of each chosen pair.
+fn preserve_pair_frames(pairs: &mut [Vec<PItemKey>], original_order: &[PItemKey]) {
+    for pair in pairs {
+        pair.sort_by_key(|key| {
+            original_order
+                .iter()
+                .position(|old| old == key)
+                .expect("source member")
+        });
+    }
+}
 
