    "crates/core/src/sheets/vstrip.rs": {
      "sha256": "c3105c733a21b4d761324155757636bf12adb57ded8d7a08ec65a7e00764a908",
      "start_line": 702,
      "snippet": "            let mut filled = false;\n            let mut stalled = 0;\n            pool.clear();\n            while self.clock.now() < explore_until {\n                let deadline = self.deadline(explore_until);\n                let before = sep.tracker.total_loss();\n                let (snapshot, tracker) = timed(\"separate\", || sep.separate(&deadline));\n                if std::env::var_os(\"NESTBOLT_TRACE\").is_some() {\n                    eprintln!(\n                        \"trace shape {:?} loss before {} after {}\",\n                        shape,\n                        before,\n                        tracker.total_loss()\n                    );\n                }\n                if tracker.total_loss() == 0.0 {\n                    stalled = 0;\n                    if !filled {\n                        // Cheap direct moves into free gaps and a bounded\n                        // number of one-sheet relocations, once per window.\n                        filled = true;\n                        let t = self.clock.now();\n                        let budget = t + (explore_until - t).max(0.0) * 0.1;\n                        // The feasible initial state is an opportunity even\n                        // when one separator call later consumes exploration.\n                        // Share the existing relocation budget; run before fill\n                        // can short-circuit the ordinary relocation path.\n                        let exchanged = if self.allow_exchange {\n                            let exchange_until = (t + 1.2).min(budget);\n                            timed(\"exchange\", || {\n                                self.directed_exchange(\n                                    &strip,\n                                    frozen,\n                                    &mut sep,\n                                    shape,\n                                    exchange_until,\n                                )\n                            })?\n                        } else {\n                            0\n                        };\n                        let gaps = std::env::var_os(\"NESTBOLT_NO_FILL\").is_none();\n                        // An accepted exchange may only rearrange parts. Keep\n                        // the direct gap-fill opportunity in the new layout.\n                        let gap_moves = if gaps {\n                            let moved = timed(\"fill\", || self.fill_gaps(&strip, &mut sep, shape));\n                            if exchanged > 0 {\n                                self.stats.post_exchange_fill_calls += 1;\n                                self.stats.post_exchange_fill_moves += moved as u64;\n                            }\n                            moved\n                        } else {\n                            0\n                        };\n                        if exchanged > 0\n                            || gap_moves > 0\n                            || timed(\"relocate\", || {\n                                self.relocate(&strip, &mut sep, shape, budget)\n                            })? > 0\n                        {\n                            shape.last = strip.fit_last(&sep.layout, shape);\n                            strip.apply(&mut sep, shape)?;\n                        }\n                    }\n                    let snapshot = sep.layout.save();\n                    best = (snapshot, shape);\n                    pending = true;\n                    pool.clear();\n                    if shape.sheets > 1 && strip.in_last(&sep.layout, shape).is_empty() {\n                        // The last sheet emptied: remove it and its wall.\n                        shape = Shape {\n                            sheets: shape.sheets - 1,\n                            ..shape\n                        };\n                        shape.last = strip.fit_last(&sep.layout, shape);\n                        strip.clear_blocker(&mut sep.layout);\n                        sep.layout.swap_container(strip.container(shape)?);\n                        strip.apply(&mut sep, shape)?;\n                        best = (sep.layout.save(), shape);\n                        self.stats.eliminated_sheets += 1;\n                        self.accept_window(&strip, frozen, &best.0, shape, \"eliminate\")?;\n                        pending = false;\n                        checked = self.clock.now();\n                        filled = false;"
    },
    "crates/core/src/sheets/vstrip/exchange.rs": {
      "sha256": "4024f0cb3d52f408a275e312eb1fff7f9eab97a6bc06a817d6073303dd832efb",
      "start_line": 666,
      "snippet": "                    let after = report.metrics.as_ref().expect(\"valid exchange\");\n                    if exchange_increases_material(before, after)\n                        || self.clock.now() >= exchange_until\n                    {\n                        continue;\n                    }\n                    // Same inventory can still improve the geometry, but a\n                    // flat material result must not consume the sole exchange.\n                    if same_original_inventory(&members, &victims)\n                        && after.material_area >= before.material_area\n                    {\n                        self.stats.neutral_exchange_rejections += 1;\n                        continue;\n                    }\n                    sep.layout = trial;\n                    sep.rebuild();\n                    self.stats.directed_exchanges += 1;\n                    self.stats.paired_exchanges += u64::from(paired);\n                    self.stats.mixed_exchanges += u64::from(mixed);\n                    return Ok(1);"
    }
  },
