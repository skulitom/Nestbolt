+    #[test]
+    fn larger_return_moves_both_incoming_with_strict_material_guard() {
+        let (job, before) = larger_return_fixture();
+        for seed in 0..4 {
+            let (moved, after, stats) = exercise(&job, &before, seed, true, false, 0);
+            eprintln!(
+                "LARGER_RETURN_WITNESS {}",
+                serde_json::json!({"case":"larger_positive","seed":seed,"job":&job,"before":&before,"after":&after,"moved":moved,"stats":&stats})
+            );
+            assert_eq!(
+                moved, 1,
+                "larger return area must not exclude a valid material-nonincreasing pair exchange: {stats:?}"
+            );
+            assert_eq!(stats.mixed_exchanges, 1);
+            assert_eq!(stats.paired_exchanges, 1);
+            for id in ["short-incoming", "tall-incoming"] {
+                assert!(
+                    after
+                        .placements
+                        .iter()
+                        .any(|p| p.part_id == id && p.sheet_id == "sheet-0")
+                );
+            }
+            assert_eq!(
+                after
+                    .placements
+                    .iter()
+                    .filter(|p| p.part_id == "return" && p.sheet_id == "sheet-1")
+                    .count(),
+                3
+            );
+        }
+    }
