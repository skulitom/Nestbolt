+    #[test]
+    fn exchange_material_guard_rejects_even_one_ulp_and_extra_sheets() {
+        let (job, layout) = fixture();
+        let before = validate(&job, &layout).unwrap().metrics.unwrap();
+        let mut after = before.clone();
+        assert!(!exchange_increases_material(&before, &after));
+        for material in [
+            before.material_area + 0.0007,
+            f64::from_bits(before.material_area.to_bits() + 1),
+        ] {
+            after.material_area = material;
+            assert!(exchange_increases_material(&before, &after));
+            after.sheets_used = before.sheets_used - 1;
+            assert!(exchange_increases_material(&before, &after));
+            after.sheets_used = before.sheets_used;
+        }
+        after.material_area = before.material_area - 1.0;
+        assert!(!exchange_increases_material(&before, &after));
+        after.sheets_used += 1;
+        assert!(exchange_increases_material(&before, &after));
+    }
+
+    #[test]
+    fn gap_fill_moves_known_part_immediately_after_exchange() {
+        let (job, layout) = gap_fixture();
+        let (exchanged, after_exchange, _) = exercise(&job, &layout, 0, true, false, 0);
+        assert_eq!(exchanged, 1);
+        assert!(
+            after_exchange
+                .placements
+                .iter()
+                .any(|p| p.part_id == "gap-part" && p.sheet_id == "sheet-1")
+        );
+        let report = validate(&job, &after_exchange).unwrap();
+        assert!(report.valid);
+        let model = Model::new(&job).unwrap();
+        let clock = Clock::new(Timing::Work, 30.0);
+        let mut search = Search {
+            model: &model,
+            allow_exchange: true,
+            rng: Xoshiro256PlusPlus::seed_from_u64(0),
+            clock: clock.clone(),
+            best: (after_exchange.clone(), report, 0.0),
+            history: vec![],
+            stats: Stats::default(),
+            progress: |_: &Progress, _: &dyn Fn() -> Option<Layout>| {},
+            check_cost: 0.0,
+            check_every: 5.0,
+        };
+        let strip = Strip {
+            model: &model,
+            gap: 2.0,
+            clock,
+            containers: Default::default(),
+        };
+        let sheets = model.sheets_of(&after_exchange).unwrap();
+        let mut shape = Shape {
+            sheets: sheets.len(),
+            last: model.full_width,
+        };
+        let initial = strip.layout(&sheets, shape).unwrap();
+        shape.last = strip.fit_last(&initial, shape);
+        let mut sep = Separator::new(
+            strip.layout(&sheets, shape).unwrap(),
+            0,
+            EXPLORE,
+            search.clock.clone(),
+        );
+        sep.pin(blocker_index(&model));
+        let before = model.to_layout(&strip.split(&sep.layout, shape.sheets).unwrap());
+        let before_report = validate(&job, &before).unwrap();
+        assert!(before_report.valid);
+        assert_eq!(search.fill_gaps(&strip, &mut sep, shape), 1);
+        assert_eq!(search.stats.direct_insertions, 1);
+        let after = model.to_layout(&strip.split(&sep.layout, shape.sheets).unwrap());
+        assert!(
+            after
+                .placements
+                .iter()
+                .any(|p| p.part_id == "gap-part" && p.sheet_id == "sheet-0")
+        );
+        let checked = validate(&job, &after).unwrap();
+        assert!(checked.valid);
+        assert!(
+            checked.metrics.unwrap().material_area <= before_report.metrics.unwrap().material_area
+        );
+        assert_eq!(sep.tracker.total_loss(), 0.0);
+        eprintln!(
+            "DIRECT_FILL_WITNESS {}",
+            serde_json::json!({"job":job,"before":before,"after":after})
+        );
+    }
