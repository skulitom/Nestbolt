+// Conservative equality: exact bits and shared immutable model identity.
+// Ignore placement keys and order, retain multiplicity. A false result does
+// not prove changed geometry (e.g. -0 versus +0); true is conservative.
+fn exact_physical_state(a: &JLayout, b: &JLayout) -> bool {
+    use std::sync::Arc;
+    if !Arc::ptr_eq(a.container().base_cde(), b.container().base_cde())
+        || !Arc::ptr_eq(a.container().outer_orig(), b.container().outer_orig())
+        || !Arc::ptr_eq(a.container().outer_cd(), b.container().outer_cd())
+        || a.placed_items().len() != b.placed_items().len()
+    {
+        return false;
+    }
+    let keys = |layout: &JLayout| {
+        let mut keys: Vec<_> = layout
+            .placed_items()
+            .values()
+            .map(|p| {
+                let dt = p.d_transf();
+                let (x, y) = dt.translation();
+                (
+                    p.item().idx(),
+                    Arc::as_ptr(p.item()) as usize,
+                    [dt.rotation().to_bits(), x.to_bits(), y.to_bits()],
+                    dt.reflected,
+                )
+            })
+            .collect();
+        keys.sort_unstable();
+        keys
+    };
+    keys(a) == keys(b)
 }
 
