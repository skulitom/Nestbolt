+    fn complete_sets_can_return_equal_or_greater_area_at_the_same_material() {
+        // The independently validated witness retains a 33 mm charged height:
+        // a 2550/2700 mm2 incoming part can trade for three 900 mm2 squares.
+        // Their relative positions fit in the otherwise empty return sheet.
+        for incoming_width in [85.0, 90.0] {
+            let (mut job, mut layout) = obstruction_set_fixture(3, 30.0);
+            for part in &mut job.parts {
+                for polygon in &mut part.geometry {
+                    for point in &mut polygon.outer {
+                        point.swap(0, 1);
+                    }
+                }
+            }
+            job.parts[2] = rectangle("incoming", incoming_width, 30.0);
+            for part in &mut layout.placements {
+                part.transform.translation.swap(0, 1);
+            }
+            let original = validate(&job, &layout).unwrap();
+            assert!(original.valid);
+            assert_eq!(original.metrics.unwrap().material_area, 13300.0);
+            let (moved, after, _) = exercise(&job, &layout, 0, true, false, 0);
+            assert_eq!(moved, 1);
+            assert_eq!(
+                after
+                    .placements
+                    .iter()
+                    .filter(|p| p.part_id == "return" && p.sheet_id == "sheet-1")
+                    .count(),
+                3
+            );
+            assert!(
+                after
+                    .placements
+                    .iter()
+                    .any(|p| p.part_id == "incoming" && p.sheet_id == "sheet-0")
+            );
+        }
     }
