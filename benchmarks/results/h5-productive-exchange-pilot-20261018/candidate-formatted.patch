+    fn equal_inventory_fixture(taller_source: bool) -> (Job, Layout) {
+        let (mut job, mut layout) = balanced_fixture();
+        job.parts.retain(|p| p.id != "return");
+        job.parts
+            .iter_mut()
+            .find(|p| p.id == "incoming")
+            .unwrap()
+            .quantity = 4;
+        layout.placements.retain(|p| p.part_id != "return");
+        for p in &mut layout.placements {
+            if taller_source && p.part_id == "incoming" && p.copy_index == 1 {
+                p.transform.translation[1] = 52.0;
+            }
+        }
+        for (copy_index, y) in [(2, 2.0), (3, 49.0)] {
+            layout.placements.push(Placement {
+                part_id: "incoming".into(),
+                copy_index,
+                sheet_id: "sheet-0".into(),
+                transform: RigidTransform {
+                    translation: [2.0, y],
+                    rotation_radians: 0.0,
+                    mirrored: false,
+                },
+            });
+        }
+        if taller_source {
+            // The validator credits the largest offcut on either sheet. Keep
+            // the receiver taller so exchanging the pairs saves real material.
+            job.parts.push(rectangle("ceiling", 94.0, 0.5));
+            layout.placements.push(Placement {
+                part_id: "ceiling".into(),
+                copy_index: 0,
+                sheet_id: "sheet-0".into(),
+                transform: RigidTransform {
+                    translation: [2.0, 98.0],
+                    rotation_radians: 0.0,
+                    mirrored: false,
+                },
+            });
+        }
+        (job, layout)
+    }
