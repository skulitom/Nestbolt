+        items.sort_by(|a, b| b.area().total_cmp(&a.area()));
+        assert_eq!(items.len(), 3);
+        let mut many = JLayout::new(sheets[0].layout().container().clone());
+        let mut keys = Vec::new();
+        for (family, item) in items.iter().enumerate() {
+            for copy in 0..20 {
+                keys.push(many.place_item(
