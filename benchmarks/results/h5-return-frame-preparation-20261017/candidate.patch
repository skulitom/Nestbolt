+    fn witness_victims(receiver: &JLayout) -> Vec<(PItemKey, Item, DTransformation)> {
+        receiver.placed_items().iter()
+            .filter(|(_, p)| p.item().external_id() == 2)
+            .map(|(key, p)| (key, p.item().clone(), p.d_transf()))
+            .collect()
+    }
