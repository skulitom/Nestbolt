+    fn return_frame_witness() -> (Job, Layout) {
+        let job = serde_json::from_str(include_str!(concat!(
+            env!("CARGO_MANIFEST_DIR"), "/../../examples/return-frame-job.json"
+        ))).unwrap();
+        let layout = serde_json::from_str(include_str!(concat!(
+            env!("CARGO_MANIFEST_DIR"), "/../../examples/return-frame-before.json"
+        ))).unwrap();
+        (job, layout)
+    }
