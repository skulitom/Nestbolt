+    #[test]
+    fn return_frame_rotates_into_the_vacated_gap_without_extra_material() {
+        let (job, before) = return_frame_witness();
+        let original = validate(&job, &before).unwrap();
+        assert!(original.valid);
+        assert_eq!(original.metrics.unwrap().material_area, 19500.0);
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&before).unwrap();
+        let incoming = sheets[1].layout().placed_items().values()
+            .find(|p| p.item().external_id() == 3).unwrap();
+        let incoming_old = incoming.d_transf();
+        let placed = RigidTransform {
+            translation: [2.0, 64.0], rotation_radians: 0.0, mirrored: false,
+        };
+        let incoming_new = model.internal(incoming.item().idx(), &placed);
+        let victims = witness_victims(sheets[0].layout());
+        assert_eq!(victims.len(), 3);
+        let poses = return_group_poses(&victims, incoming_new, incoming_old);
+        let mut after = before.clone();
+        let p = after.placements.iter_mut().find(|p| p.part_id == "incoming").unwrap();
+        p.sheet_id = "sheet-0".into();
+        p.transform = placed;
+        for ((p, (_, item, _)), pose) in after.placements.iter_mut()
+            .filter(|p| p.part_id == "return").zip(&victims).zip(&poses)
+        {
+            assert!(item.allowed_orientations().allows(pose));
+            p.sheet_id = "sheet-1".into();
+            p.transform = model.external(item.idx(), pose);
+        }
+        let report = validate(&job, &after).unwrap();
+        assert!(report.valid, "{:?}", report.violations);
+        assert_eq!(report.metrics.unwrap().material_area, 19500.0);
+        let (fx, fy) = incoming_new.translation();
+        let (tx, ty) = incoming_old.translation();
+        for (p, (_, item, previous)) in after.placements.iter_mut()
+            .filter(|p| p.part_id == "return").zip(&victims)
+        {
+            let (x, y) = previous.translation();
+            let translated = DTransformation::new(previous.rotation(), (x + tx - fx, y + ty - fy))
+                .with_reflection(previous.reflected);
+            p.transform = model.external(item.idx(), &translated);
+        }
+        assert!(!validate(&job, &after).unwrap().valid);
+    }
+
+    #[test]
+    fn directed_exchange_uses_the_rotated_return_gap() {
+        let (mut job, before) = return_frame_witness();
+        // Keep the incoming part first in the area-ranked source list. A narrow
+        // tall neighbour still obstructs the old translation-only return pose.
+        job.parts[1] = rectangle("source-filler", 20.0, 94.0);
+        let (moved, after, stats) = exercise(&job, &before, 0, true, false, 0);
+        assert_eq!(moved, 1);
+        assert_eq!(stats.directed_exchanges, 1);
+        assert!(after.placements.iter().any(|p| p.part_id == "incoming" && p.sheet_id == "sheet-0"));
+        assert_eq!(after.placements.iter().filter(|p| p.part_id == "return" && p.sheet_id == "sheet-1").count(), 3);
+    }
+
+    #[test]
+    fn return_frame_preserves_permitted_reflection_and_relative_positions() {
+        let (mut job, before) = return_frame_witness();
+        job.parts[2].allow_mirror = true;
+        job.parts[3].allow_mirror = true;
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&before).unwrap();
+        let mut victims = witness_victims(sheets[0].layout());
+        for (i, (_, _, previous)) in victims.iter_mut().enumerate() {
+            *previous = DTransformation::new(0.0, (12.0 + 6.0 * i as f32, 23.0));
+        }
+        let here = DTransformation::new(0.0, (10.0, 20.0));
+        let old = DTransformation::new(std::f32::consts::FRAC_PI_2, (40.0, 50.0)).with_reflection(true);
+        let poses = return_group_poses(&victims, here, old);
+        // (x,y) relative to the old incoming frame maps to (y,x), then (40,50).
+        for (i, (pose, (_, item, _))) in poses.iter().zip(&victims).enumerate() {
+            assert!(pose.reflected && item.allowed_orientations().allows(pose));
+            let (x, y) = pose.translation();
+            assert!((x - 43.0).abs() < 0.0001);
+            assert!((y - (52.0 + 6.0 * i as f32)).abs() < 0.0001);
+            let matrix = pose.compose();
+            let matrix = matrix.matrix();
+            assert!(matrix[0][0].into_inner().abs() < 0.0001);
+            assert!((matrix[0][1].into_inner() - 1.0).abs() < 0.0001);
+            assert!((matrix[1][0].into_inner() - 1.0).abs() < 0.0001);
+            assert!(matrix[1][1].into_inner().abs() < 0.0001);
+        }
+    }
+
+    #[test]
+    fn return_frame_falls_back_for_the_whole_group_if_any_orientation_is_forbidden() {
+        let (job, before) = return_frame_witness();
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&before).unwrap();
+        for reflected in [false, true] {
+            let mut victims = witness_victims(sheets[0].layout());
+            if !reflected {
+                // Only the first member forbids the quarter-turn. All members
+                // must retain the old translation, rather than deform the set.
+                victims[0].1 = sheets[0].layout().placed_items().values()
+                    .find(|p| p.item().external_id() == 0).unwrap().item().clone();
+            }
+            let here = DTransformation::new(3.0 * std::f32::consts::FRAC_PI_2, (10.0, 20.0));
+            let old = DTransformation::new(
+                if reflected { std::f32::consts::FRAC_PI_2 } else { 0.0 },
+                (40.0, 50.0),
+            ).with_reflection(reflected);
+            let poses = return_group_poses(&victims, here, old);
+            for (pose, (_, item, previous)) in poses.iter().zip(&victims) {
+                assert!(item.allowed_orientations().allows(pose));
+                assert_eq!(pose.rotation(), previous.rotation());
+                assert_eq!(pose.reflected, previous.reflected);
+                let (x, y) = previous.translation();
+                assert_eq!(pose.translation(), (x + 30.0, y + 30.0));
+            }
+        }
+    }
