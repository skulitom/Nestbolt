+        assert_eq!(moved, 3, "Whole window must cross the remaining flat state");
+        assert_eq!(stats.directed_exchanges, 3);
+        assert!(stats.assignment_bridge_flat_steps > 0);
+        assert_eq!(stats.assignment_bridge_committed, 2);
+        assert_eq!(stats.assignment_bridge_rolled_back, 0);
+        assert!(
+            validate(&job, &after)
+                .unwrap()
+                .metrics
+                .unwrap()
+                .material_area
+                < 33000.0
+        );
+        let (again, replay, replay_stats) =
+            assignment_bridge_exercise(&job, &layout, 0, true, (3.0, 12.0, 0), 0);
+        assert_eq!(again, moved);
+        assert_eq!(
+            serde_json::to_value(after).unwrap(),
+            serde_json::to_value(replay).unwrap()
+        );
+        assert_eq!(
+            serde_json::to_value(stats).unwrap(),
+            serde_json::to_value(replay_stats).unwrap()
+        );
+    }
+
+    #[test]
