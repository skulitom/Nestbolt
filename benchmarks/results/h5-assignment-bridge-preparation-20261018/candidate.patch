+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ExchangePolicy {
+    Short,
+    Extended,
+    AssignmentBridge,
+}
+
+// Stable original-part order gives equal inventories exactly equal areas,
+// regardless of placement keys, copy order, internal orientation or reflection.
+// Hole interiors remain reserved. This is an internal progress measure only.
+fn assignment_source_area(strip: &Strip, layout: &JLayout, shape: Shape) -> f64 {
+    let mut counts = vec![0_usize; strip.model.job.parts.len()];
+    for p in layout
+        .placed_items()
+        .values()
+        .filter(|p| !strip.is_blocker(p) && strip.sheet_of(p.shape()) == shape.sheets - 1)
+    {
+        counts[strip.model.part[p.item().idx()]] += 1;
+    }
+    strip
+        .clock
+        .charge(Work::RegisteredItem, layout.placed_items().len() as f64);
+    let mut area = 0.0;
+    for (part, count) in strip.model.job.parts.iter().zip(counts) {
+        if count == 0 {
+            continue;
+        }
+        let one = part
+            .geometry
+            .iter()
+            .map(|g| crate::curves::signed_area(&g.outer).abs())
+            .sum::<f64>();
+        let vertices = part.geometry.iter().map(|g| g.outer.len()).sum::<usize>();
+        strip.clock.charge(Work::TrackedVertex, vertices as f64);
+        area += one * count as f64;
+    }
+    area
+}
