+    fn assignment_bridge_chain(
+        &mut self,
+        strip: &Strip,
+        frozen: &[SPProblem],
+        sep: &mut Separator,
+        shape: Shape,
+        until: f64,
+        accepted: usize,
+    ) -> Result<usize> {
+        if accepted >= 4
+            || !self.allow_exchange
+            || shape.sheets < 2
+            || self.clock.now() >= self.last_step(until)
+        {
+            return Ok(0);
+        }
+        let mut checkpoint = (
+            sep.layout.save(),
+            sep.tracker.clone(),
+            [
+                self.stats.directed_exchanges,
+                self.stats.paired_exchanges,
+                self.stats.mixed_exchanges,
+                self.stats.extended_exchanges,
+            ],
+        );
+        self.clock
+            .charge(Work::RegisteredItem, sep.layout.placed_items().len() as f64);
+        let mut pending = 0_usize;
+        let mut committed = 0_usize;
+        let outcome = (|| -> Result<()> {
+            for _ in accepted..4 {
+                let Some(improved) = self.directed_exchange_policy(
+                    strip,
+                    frozen,
+                    sep,
+                    shape,
+                    until,
+                    ExchangePolicy::AssignmentBridge,
+                )?
+                else {
+                    break;
+                };
+                pending += 1;
+                self.stats.assignment_bridge_steps += 1;
+                self.stats.assignment_bridge_flat_steps += u64::from(!improved);
+                if improved {
+                    committed += pending;
+                    self.stats.assignment_bridge_committed += pending as u64;
+                    pending = 0;
+                    checkpoint = (
+                        sep.layout.save(),
+                        sep.tracker.clone(),
+                        [
+                            self.stats.directed_exchanges,
+                            self.stats.paired_exchanges,
+                            self.stats.mixed_exchanges,
+                            self.stats.extended_exchanges,
+                        ],
+                    );
+                    self.clock
+                        .charge(Work::RegisteredItem, sep.layout.placed_items().len() as f64);
+                }
+            }
+            Ok(())
+        })();
+        // The snapshot and tracker are kept together: stale placement keys
+        // are never transferred to a separately rebuilt/re-keyed layout.
+        // Keep attempts and provisional diagnostics, restore only committed
+        // acceptance counts along with the last strictly improved incumbent.
+        if pending > 0 {
+            self.stats.assignment_bridge_rolled_back += pending as u64;
+            self.stats.assignment_bridge_rollbacks += 1;
+            sep.layout = JLayout::from_snapshot(&checkpoint.0);
+            sep.tracker = checkpoint.1;
+            self.clock
+                .charge(Work::RegisteredItem, sep.layout.placed_items().len() as f64);
+            [
+                self.stats.directed_exchanges,
+                self.stats.paired_exchanges,
+                self.stats.mixed_exchanges,
+                self.stats.extended_exchanges,
+            ] = checkpoint.2;
+        }
+        outcome?;
+        Ok(committed)
+    }
