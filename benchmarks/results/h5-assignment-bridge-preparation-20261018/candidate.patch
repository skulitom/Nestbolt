+        let (job, layout) = assignment_bridge_fixture();
+        let (moved, after, stats) =
+            assignment_bridge_exercise(&job, &layout, 0, true, (0.0, 12.0, 1), 0);
+        assert_eq!(moved, 3, "Tail must bridge two flat states");
+        assert_eq!(stats.assignment_bridge_flat_steps, 2);
+        assert_eq!(stats.assignment_bridge_steps, 3);
+        assert_eq!(stats.assignment_bridge_committed, 3);
+        assert_eq!(stats.assignment_bridge_rolled_back, 0);
+        assert!(
+            validate(&job, &after)
+                .unwrap()
+                .metrics
+                .unwrap()
+                .material_area
+                < 33000.0
+        );
+    }
+
+    #[test]
+    fn assignment_bridge_new_no_final_gain_restores_active_and_frozen_layouts() {
+        let (job, layout) = assignment_bridge_fixture();
+        let (moved, _, stats) =
+            assignment_bridge_exercise(&job, &layout, 0, true, (0.0, 12.0, 1), 1);
+        assert_eq!(moved, 0);
+        assert_eq!(stats.directed_exchanges, 0);
+        assert!(
+            stats.assignment_bridge_flat_steps > 0,
+            "Actual flat steps must be tried before rollback"
+        );
+        assert_eq!(
+            stats.assignment_bridge_steps,
+            stats.assignment_bridge_rolled_back
+        );
+        assert_eq!(stats.assignment_bridge_committed, 0);
+        assert_eq!(stats.assignment_bridge_rollbacks, 1);
+    }
+
+    #[test]
+    fn assignment_bridge_new_disabled_expired_and_fast_expiry_keep_incumbents() {
+        let (job, layout) = assignment_bridge_fixture();
+        let (_, baseline, _) =
+            assignment_bridge_exercise(&job, &layout, 0, false, (0.0, 12.0, 1), 0);
+        for (enabled, budget) in [(false, 12.0), (true, 0.0), (true, 1e-12)] {
+            let (moved, after, stats) =
+                assignment_bridge_exercise(&job, &layout, 0, enabled, (0.0, budget, 1), 0);
+            assert_eq!(moved, 0);
+            assert_eq!(stats.assignment_bridge_steps, 0);
+            assert_eq!(
+                serde_json::to_value(after).unwrap(),
+                serde_json::to_value(&baseline).unwrap()
+            );
+        }
+        let (moved, _, stats) =
+            assignment_bridge_exercise(&job, &layout, 0, true, (3.0, 12.0, 2), 0);
+        assert_eq!(moved, 1);
+        assert_eq!(stats.assignment_bridge_steps, 0);
+    }
+
+    #[test]
+    fn assignment_bridge_new_last_available_slot_cannot_publish_a_flat_step() {
+        let (job, layout) = assignment_bridge_fixture();
+        let (moved, _, stats) =
+            assignment_bridge_exercise(&job, &layout, 0, true, (0.0, 12.0, 3), 0);
+        assert_eq!(moved, 0);
+        assert_eq!(stats.directed_exchanges, 0);
+        assert_eq!(
+            stats.assignment_bridge_steps, 1,
+            "One remaining slot must admit one provisional flat step"
+        );
+        assert_eq!(stats.assignment_bridge_flat_steps, 1);
+        assert_eq!(stats.assignment_bridge_rolled_back, 1);
+        assert_eq!(stats.assignment_bridge_committed, 0);
+    }
+
+    #[test]
+    fn assignment_bridge_new_keeps_the_prior_fast_opportunities() {
+        for ((job, layout), seed) in [(larger_return_fixture(), 3), (mixed_fixture(), 0)] {
+            let (fast, baseline, _) = chain_exercise(&job, &layout, seed, true, 3.0, 0);
+            assert!(fast > 0);
+            let (moved, after, stats) =
+                assignment_bridge_exercise(&job, &layout, seed, true, (3.0, 5.0, 0), 0);
+            assert!((fast..=4).contains(&moved));
+            assert_eq!(stats.directed_exchanges, moved as u64);
+            assert_eq!(stats.assignment_bridge_committed, (moved - fast) as u64);
+            assert_eq!(
+                stats.assignment_bridge_steps,
+                stats.assignment_bridge_committed + stats.assignment_bridge_rolled_back
+            );
+            if moved > fast {
+                assert!(
+                    validate(&job, &after)
+                        .unwrap()
+                        .metrics
+                        .unwrap()
+                        .material_area
+                        < validate(&job, &baseline)
+                            .unwrap()
+                            .metrics
+                            .unwrap()
+                            .material_area
+                );
+            } else {
+                assert_eq!(
+                    serde_json::to_value(after).unwrap(),
+                    serde_json::to_value(baseline).unwrap()
+                );
+            }
+        }
+    }
