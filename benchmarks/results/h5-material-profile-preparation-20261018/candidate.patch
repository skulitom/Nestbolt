+//! Rejection evidence only. Equal highest original coordinates and unchanged
+//! sheet/stock assignments feed the same charged-material calculation.
+//! This deliberately does not establish collision freedom or validity.
+use nestbolt_validator::Footprint;
+use nestbolt_validator::job::{Job, Layout};
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Debug)]
+pub(super) struct MaterialProfile<'a> {
+    // Retain the immutable job borrow: profiles from different jobs never match.
+    job: &'a Job,
+    sheets: BTreeMap<String, (String, u64)>,
+    copies: BTreeSet<(String, u32)>,
+}
+
+impl PartialEq for MaterialProfile<'_> {
+    fn eq(&self, other: &Self) -> bool {
+        std::ptr::eq(self.job, other.job)
+            && self.sheets == other.sheets
+            && self.copies == other.copies
+    }
+}
+impl Eq for MaterialProfile<'_> {}
+
+pub(super) fn material_profile<'a>(job: &'a Job, layout: &Layout) -> Option<MaterialProfile<'a>> {
+    if layout.units != job.units || layout.placements.is_empty() || layout.sheets.is_empty() {
+        return None;
+    }
+    let mut parts = BTreeMap::new();
+    for part in &job.parts {
+        if parts.insert(part.id.as_str(), part).is_some() {
+            return None;
+        }
+    }
+    let mut stocks = BTreeSet::new();
+    for stock in &job.stocks {
+        if !stocks.insert(stock.id.as_str()) {
+            return None;
+        }
+    }
+    let mut assignments = BTreeMap::new();
+    for sheet in &layout.sheets {
+        if !stocks.contains(sheet.stock_id.as_str())
+            || assignments
+                .insert(sheet.id.as_str(), sheet.stock_id.as_str())
+                .is_some()
+        {
+            return None;
+        }
+    }
+    let mut highest = BTreeMap::<&str, f64>::new();
+    let mut copies = BTreeSet::new();
+    for placement in &layout.placements {
+        let part = parts.get(placement.part_id.as_str())?;
+        if placement.copy_index >= part.quantity
+            || !copies.insert((placement.part_id.clone(), placement.copy_index))
+            || !assignments.contains_key(placement.sheet_id.as_str())
+        {
+            return None;
+        }
+        // Use the actual validator implementation, including its grid,
+        // original components/holes, reflection, rotation and declared units.
+        let footprint =
+            Footprint::from_polygons(&part.geometry, job.units, placement.transform).ok()?;
+        let top = footprint.bounds()[3];
+        if !top.is_finite() {
+            return None;
+        }
+        highest
+            .entry(placement.sheet_id.as_str())
+            .and_modify(|value| *value = value.max(top))
+            .or_insert(top);
+    }
+    let mut sheets = BTreeMap::new();
+    for (id, stock) in assignments {
+        sheets.insert(
+            id.to_owned(),
+            (stock.to_owned(), highest.get(id)?.to_bits()),
+        );
+    }
+    Some(MaterialProfile {
+        job,
+        sheets,
+        copies,
+    })
+}
