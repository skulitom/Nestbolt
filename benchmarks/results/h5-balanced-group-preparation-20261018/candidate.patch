+// Incoming groups must preserve their relative transform and every member's
+// permissions. An illegal mapped orientation rejects this proposal as a whole.
+fn incoming_group_poses(members: &[IncomingMember], anchor: DTransformation) -> Option<Vec<DTransformation>> {
+    let old = members.first()?.2;
+    let same = old.rotation() == anchor.rotation() && old.reflected == anchor.reflected;
+    let frame = old.compose().inverse().transform(&anchor.compose());
+    let (ox, oy) = old.translation();
+    let (nx, ny) = anchor.translation();
+    members.iter().enumerate().map(|(i, (_, item, previous))| {
+        let pose = if i == 0 { anchor } else if same {
+            let (px, py) = previous.translation();
+            DTransformation::new(previous.rotation(), (px + nx - ox, py + ny - oy)).with_reflection(previous.reflected)
+        } else {
+            previous.compose().transform(&frame).decompose()
+        };
+        item.allowed_orientations().allows(&pose).then_some(pose)
+    }).collect()
+}
