+fn paired_proposals(receiver: &JLayout, incoming: &[IncomingMember], rng: &mut Xoshiro256PlusPlus,
+                    clock: &Clock, until: f64) -> Vec<Proposal> {
+    debug_assert_eq!(incoming.len(), 2);
+    let anchor = &incoming[0].1;
+    let bounds = receiver.container().outer_cd().bbox();
+    let mut samples = Vec::new();
+    let mut buffer = anchor.shape_cd().as_ref().clone();
+    for p in receiver.placed_items().values() {
+        let dt = convert_sample_to_closest_feasible(p.d_transf(), anchor);
+        buffer.transform_from(anchor.shape_cd(), &dt.compose());
+        let a = buffer.bbox(); let b = p.shape().bbox(); let (x, y) = dt.translation();
+        samples.push(DTransformation::new(dt.rotation(), (x + b.x_min - a.x_min, y + b.y_min - a.y_min)).with_reflection(dt.reflected));
+    }
+    if let Some(sampler) = UniformBBoxSampler::new(bounds, anchor, bounds) {
+        samples.extend((0..128).map(|_| sampler.sample(rng)));
+    }
+    let incoming_area: f32 = incoming.iter().map(|(_, item, _)| item.area()).sum();
+    let mut collector = BasicHazardCollector::new();
+    let mut out = Vec::new();
+    for sample in samples {
+        if clock.now() >= until { break; }
+        let Some(poses) = incoming_group_poses(incoming, sample) else { continue; };
+        let mut collisions = Vec::new();
+        let mut allowed = true;
+        for ((_, item, _), pose) in incoming.iter().zip(&poses) {
+            buffer = item.shape_cd().as_ref().clone();
+            buffer.transform_from(item.shape_cd(), &pose.compose());
+            collector.clear();
+            receiver.cde().collect_poly_collisions(&buffer, &NoFilter, &mut collector);
+            crate::separate::charge(clock, item, 1);
+            for (_, hazard) in collector.iter() {
+                if let BasicHazardEntity::PlacedItem { pk, .. } = hazard {
+                    if !collisions.contains(pk) { collisions.push(*pk); }
+                } else { allowed = false; }
+            }
+            if !allowed || collisions.len() > 3 { break; }
+        }
+        if !allowed || collisions.is_empty() || collisions.len() > 3 { continue; }
+        // Keep the complete union of both incoming members' actual obstructions.
+        let victims: Vec<_> = receiver.placed_items().iter().enumerate()
+            .filter(|(_, (key, _))| collisions.contains(key)).collect();
+        let area: f32 = victims.iter().map(|(_, (_, p))| p.item().area()).sum();
+        if area > incoming_area { continue; }
+        retain_proposal(&mut out, Proposal {
+            victims: victims.iter().map(|(_, (key, _))| *key).collect(),
+            incoming: sample, blockers: victims.len(), rank: victims[0].0, area,
+        });
+    }
+    out
 }
 
