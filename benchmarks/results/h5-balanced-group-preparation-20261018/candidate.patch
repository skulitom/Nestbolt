+type IncomingMember = (PItemKey, std::sync::Arc<Item>, DTransformation);
+
+// Try nearby copies of the same original part. Stable input order breaks ties;
+// at most twelve anchors, two neighbours each and six distinct pairs are kept.
+fn incoming_pairs(layout: &JLayout, keys: &[PItemKey]) -> Vec<Vec<PItemKey>> {
+    let mut pairs = Vec::new();
+    let mut seen = Vec::new();
+    for (i, &key) in keys.iter().enumerate().take(12) {
+        let a = &layout.placed_items()[key];
+        let ba = a.shape().bbox();
+        let mut neighbours: Vec<_> = keys.iter().enumerate().filter_map(|(j, &other)| {
+            let b = &layout.placed_items()[other];
+            if i == j || !std::sync::Arc::ptr_eq(a.item(), b.item()) { return None; }
+            let bb = b.shape().bbox();
+            let dx = (ba.x_min + ba.x_max) - (bb.x_min + bb.x_max);
+            let dy = (ba.y_min + ba.y_max) - (bb.y_min + bb.y_max);
+            Some((dx * dx + dy * dy, j))
+        }).collect();
+        neighbours.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+        for (_, j) in neighbours.into_iter().take(2) {
+            let pair = (i.min(j), i.max(j));
+            if seen.contains(&pair) { continue; }
+            seen.push(pair);
+            pairs.push(vec![keys[pair.0], keys[pair.1]]);
+            if pairs.len() == 6 { return pairs; }
+        }
+    }
+    pairs
+}
