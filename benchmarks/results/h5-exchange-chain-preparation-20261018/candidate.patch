+    fn chain_fixture() -> (Job, Layout) {
+        let (mut job, mut layout) = fixture();
+        job.name = "Two successive source-height reductions".into();
+        job.parts[0].quantity = 2;
+        job.parts[1].quantity = 2;
+        job.parts.push(rectangle("incoming-short", 30.0, 65.0));
+        layout.sheets.push(Sheet {
+            id: "sheet-2".into(),
+            stock_id: "stock".into(),
+        });
+        layout.placements[2].sheet_id = "sheet-2".into();
+        for index in 0..2 {
+            let mut p = layout.placements[index].clone();
+            p.copy_index = 1;
+            p.sheet_id = "sheet-1".into();
+            layout.placements.push(p);
+        }
+        layout.placements.push(Placement {
+            part_id: "incoming-short".into(),
+            copy_index: 0,
+            sheet_id: "sheet-2".into(),
+            transform: RigidTransform {
+                translation: [36.0, 2.0],
+                ..Default::default()
+            },
+        });
+        assert!(validate(&job, &layout).unwrap().valid);
+        (job, layout)
+    }
