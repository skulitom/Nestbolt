+    #[test]
+    fn exchange_chain_policy_stops_on_flat_failure_and_four_successes() {
+        let mut calls = 0;
+        assert_eq!(
+            continue_exchanges(|| {
+                calls += 1;
+                Ok(Some(true))
+            })
+            .unwrap(),
+            4
+        );
+        assert_eq!(calls, 4);
+        for (sequence, expected, counter) in [
+            (vec![Some(false), Some(true)], 1, 1),
+            (vec![Some(true), None, Some(true)], 1, 2),
+            (vec![Some(true), Some(false), Some(true)], 2, 2),
+            (vec![None, Some(true)], 0, 1),
+        ] {
+            let mut calls = 0;
+            let moved = continue_exchanges(|| {
+                let result = sequence[calls];
+                calls += 1;
+                Ok(result)
+            })
+            .unwrap();
+            assert_eq!(moved, expected);
+            assert_eq!(calls, counter);
+        }
+    }
+
+    #[test]
+    fn exchange_chain_accepts_successive_valid_gains_and_replays() {
+        let (job, layout) = chain_fixture();
+        let (once, one, _) = exercise(&job, &layout, 0, true, false, 0);
+        assert_eq!(once, 1);
+        let (moved, after, stats) = chain_exercise(&job, &layout, 0, true, 3.0, 0);
+        assert!((2..=4).contains(&moved), "successive exchanges: {stats:?}");
+        assert_eq!(stats.directed_exchanges, moved as u64);
+        assert!(
+            validate(&job, &after)
+                .unwrap()
+                .metrics
+                .unwrap()
+                .material_area
+                < validate(&job, &one).unwrap().metrics.unwrap().material_area
+        );
+        let (again, replay, _) = chain_exercise(&job, &layout, 0, true, 3.0, 0);
+        assert_eq!(again, moved);
+        assert_eq!(
+            serde_json::to_value(after).unwrap(),
+            serde_json::to_value(replay).unwrap()
+        );
+    }
+
+    #[test]
+    fn exchange_chain_disabled_expired_and_validation_deadline_preserve_incumbent() {
+        let (job, layout) = chain_fixture();
+        let (_, baseline, _) = chain_exercise(&job, &layout, 0, false, 3.0, 0);
+        for (enabled, budget) in [(false, 3.0), (true, 0.0), (true, 1e-12)] {
+            let (moved, after, stats) = chain_exercise(&job, &layout, 0, enabled, budget, 0);
+            assert_eq!(moved, 0);
+            assert_eq!(stats.directed_exchanges, 0);
+            assert_eq!(
+                serde_json::to_value(after).unwrap(),
+                serde_json::to_value(&baseline).unwrap()
+            );
+        }
+    }
+
+    #[test]
+    fn exchange_chain_failed_repair_preserves_frozen_and_active_sheets() {
+        let (mut job, layout) = chain_fixture();
+        job.parts[2] = rectangle("incoming", 20.0, 10.0);
+        job.parts[3] = rectangle("incoming-short", 20.0, 10.0);
+        let (moved, _, stats) = chain_exercise(&job, &layout, 0, true, 3.0, 1);
+        assert_eq!(moved, 0);
+        assert_eq!(stats.directed_exchanges, 0);
+    }
+    // END exchange-chain tests
