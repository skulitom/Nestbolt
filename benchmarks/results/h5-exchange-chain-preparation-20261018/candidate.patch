+    fn chain_exercise(
+        job: &Job,
+        layout: &Layout,
+        seed: u64,
+        enabled: bool,
+        budget: f64,
+        frozen_count: usize,
+    ) -> (usize, Layout, Stats) {
+        let validation = validate(job, layout).unwrap();
+        assert!(validation.valid, "{:?}", validation.violations);
+        let model = Model::new(job).unwrap();
+        let clock = Clock::new(Timing::Work, 30.0);
+        let mut search = Search {
+            model: &model,
+            allow_exchange: enabled,
+            rng: Xoshiro256PlusPlus::seed_from_u64(seed),
+            clock: clock.clone(),
+            best: (layout.clone(), validation, 0.0),
+            history: vec![],
+            stats: Stats::default(),
+            progress: |_: &Progress, _: &dyn Fn() -> Option<Layout>| {},
+            check_cost: 0.0,
+            check_every: 5.0,
+        };
+        let strip = Strip {
+            model: &model,
+            gap: 2.0,
+            clock,
+            containers: Default::default(),
+        };
+        let sheets = model.sheets_of(layout).unwrap();
+        let (frozen, window) = sheets.split_at(frozen_count);
+        let mut shape = Shape {
+            sheets: window.len(),
+            last: model.full_width,
+        };
+        let initial = strip.layout(window, shape).unwrap();
+        shape.last = strip.fit_last(&initial, shape);
+        let mut sep = Separator::new(
+            strip.layout(window, shape).unwrap(),
+            seed,
+            EXPLORE,
+            search.clock.clone(),
+        );
+        sep.pin(blocker_index(&model));
+        assert_eq!(sep.tracker.total_loss(), 0.0);
+        // Compare the same f32 internal frame before/after the exchange. The
+        // public-to-internal conversion predates this operation and has its own
+        // tests; comparing to the authored f64 coordinates conflates the two.
+        let mut before_sheets = frozen.to_vec();
+        before_sheets.extend(strip.split(&sep.layout, shape.sheets).unwrap());
+        let before_layout = model.to_layout(&before_sheets);
+        let before_report = validate(job, &before_layout).unwrap();
+        assert!(before_report.valid);
+        let before_material = before_report.metrics.as_ref().unwrap().material_area;
+        let original = fingerprint(&sep.layout);
+        let until = if budget <= 0.0 {
+            0.0
+        } else {
+            search.clock.now() + budget
+        };
+        let moved = search
+            .directed_exchange_chain(&strip, frozen, &mut sep, shape, until)
+            .unwrap();
+        if moved == 0 {
+            assert_eq!(
+                fingerprint(&sep.layout),
+                original,
+                "failed proposal mutated the original state"
+            );
+        }
+        let mut after_sheets = frozen.to_vec();
+        after_sheets.extend(strip.split(&sep.layout, shape.sheets).unwrap());
+        let after = model.to_layout(&after_sheets);
+        for i in 0..frozen_count {
+            let id = format!("sheet-{i}");
+            let before_fixed: Vec<_> = before_layout
+                .placements
+                .iter()
+                .filter(|p| p.sheet_id == id)
+                .collect();
+            let after_fixed: Vec<_> = after
+                .placements
+                .iter()
+                .filter(|p| p.sheet_id == id)
+                .collect();
+            assert_eq!(
+                serde_json::to_value(before_fixed).unwrap(),
+                serde_json::to_value(after_fixed).unwrap()
+            );
+        }
+        let report = validate(job, &after).unwrap();
+        assert!(report.valid, "{:?}", report.violations);
+        assert!(report.metrics.as_ref().unwrap().material_area <= before_material);
+        assert_eq!(sep.tracker.total_loss(), 0.0);
+        eprintln!(
+            "CHAIN_WITNESS {}",
+            serde_json::json!({"job":job,"before":before_layout,"after":after,"seed":seed,"enabled":enabled,"budget":budget,"moved":moved,"work":search.clock.counts(),"until":until,"finished":search.clock.now()})
+        );
+        (moved, after, search.stats)
+    }
