+// A successful flat exchange remains accepted, but must end continuation.
+fn continue_exchanges(mut step: impl FnMut() -> Result<Option<bool>>) -> Result<usize> {
+    let mut accepted = 0;
+    for _ in 0..4 {
+        let Some(material_improved) = step()? else {
+            break;
+        };
+        accepted += 1;
+        if !material_improved {
+            break;
+        }
+    }
+    Ok(accepted)
+}
