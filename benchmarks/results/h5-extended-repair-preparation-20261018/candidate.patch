+    #[test]
+    fn extended_repair_shares_four_acceptance_cap_and_stops_after_no_move() {
+        for accepted in 0..=4 {
+            let mut calls = 0;
+            let extra = continue_remaining_exchanges(accepted, || {
+                calls += 1;
+                Ok(Some(true))
+            })
+            .unwrap();
+            assert_eq!(extra, 4 - accepted, "Remaining allowance must be usable");
+            assert_eq!(calls, 4 - accepted);
+        }
+        let mut calls = 0;
+        assert_eq!(
+            continue_remaining_exchanges(1, || {
+                calls += 1;
+                Ok(None)
+            })
+            .unwrap(),
+            0
+        );
+        assert_eq!(calls, 1);
+    }
