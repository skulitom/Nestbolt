+// Both phases share the original four-acceptance window cap.
+fn continue_remaining_exchanges(
+    accepted: usize,
+    mut step: impl FnMut() -> Result<Option<bool>>,
+) -> Result<usize> {
+    let mut extra = 0;
+    for _ in accepted..4 {
+        let Some(material_improved) = step()? else {
+            break;
+        };
+        extra += 1;
+        if !material_improved {
+            break;
+        }
+    }
+    Ok(extra)
+}
+
+fn source_repair_deadline(short: f64, phase: f64, extended: bool) -> f64 {
+    if extended { phase } else { short }
+}
