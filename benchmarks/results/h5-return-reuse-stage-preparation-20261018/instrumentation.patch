+struct SamplingTrace {
+    incoming_area: f32,
+    samples: usize,
+    examined: usize,
+    collision_free: usize,
+    over_three_collisions: usize,
+    non_item_collision: usize,
+    multi_eligible_smaller: usize,
+    multi_eligible_not_smaller: usize,
+    smallest_not_smaller_area_ratio: Option<f32>,
+    retained_victim_counts: Vec<usize>,
+    retained_blocker_counts: Vec<usize>,
+}
+#[derive(serde::Serialize)]
+struct AttemptTrace {
+    incoming_area: f32,
+    returned_area: f32,
+    victims: usize,
+    blockers: usize,
+    receiver_loss: Option<f32>,
+    source_loss: Option<f32>,
+    receiver_initial_loss: Option<f32>,
+    source_initial_loss: Option<f32>,
+    source_fresh_loss: Option<f32>,
+    source_reused: Option<bool>,
+    source_initial_weighted_loss: Option<f32>,
+    source_best_weighted_loss: Option<f32>,
+    source_elapsed_seconds: Option<f64>,
+    source_available_budget: Option<f64>,
+    source_inventory: Option<Vec<usize>>,
+    before_material: f64,
+    after_material: Option<f64>,
+    frame: serde_json::Value,
+    outcome: &'static str,
+}
+impl Drop for ExchangeTrace {
+    fn drop(&mut self) {
+        eprintln!("OBSTRUCTION_DIAG {}", serde_json::to_string(self).expect("diagnostic serialization"));
+    }
+}
+
+
+fn observed_pose(pose: DTransformation) -> serde_json::Value {
+    serde_json::json!({"rotation":pose.rotation(),"reflected":pose.reflected,"translation":pose.translation()})
+}
+
+fn observed_return_frame(
+    victims: &[(PItemKey, std::sync::Arc<Item>, DTransformation)],
+    here: DTransformation,
+    old: DTransformation,
+    actual: &[DTransformation],
+) -> serde_json::Value {
+    let same = here.rotation() == old.rotation() && here.reflected == old.reflected;
+    let frame = here.compose().inverse().transform(&old.compose());
+    let hypothetical: Vec<_> = victims.iter().map(|(_,item,previous)| {
+        let pose=previous.compose().transform(&frame).decompose();
+        (pose,item.allowed_orientations().allows(&pose))
+    }).collect();
+    let mode = if victims.len()==1 {"single"} else if same {"same_frame_translation"}
+        else if hypothetical.iter().all(|(_,allowed)|*allowed) {"reciprocal"} else {"forbidden_translation"};
+    let members: Vec<_> = victims.iter().zip(actual).zip(hypothetical).map(|(((_,item,previous),actual),(hypothetical,allowed))| {
+        serde_json::json!({"external_id":item.external_id(),"previous":observed_pose(*previous),
+            "hypothetical":observed_pose(hypothetical),"hypothetical_allowed":allowed,
+            "actual":observed_pose(*actual),"actual_allowed":item.allowed_orientations().allows(actual)})
+    }).collect();
+    serde_json::json!({"mode":mode,"incoming_before":observed_pose(old),"incoming_here":observed_pose(here),"members":members})
+}
 
