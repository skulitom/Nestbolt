+    // Repair only these two inventories. Other active sheets are absent from
+    // this temporary strip and therefore cannot be moved by collision repair.
+    // A proposal selects its initial members, not the final number of movers.
+    fn joint_repair_pair(
+        &mut self,
+        strip: &Strip,
+        receiver: JLayout,
+        source: JLayout,
+        last: f32,
+        until: f64,
+    ) -> Result<Option<[LayoutSnapshot; 2]>> {
+        if !self.allow_exchange || self.clock.now() >= self.last_step(until) {
+            return Ok(None);
+        }
+        self.stats.joint_repair_attempts += 1;
+        let shape = Shape { sheets: 2, last };
+        let mut trial = JLayout::new(strip.container(shape)?);
+        let count = receiver.placed_items().len() + source.placed_items().len();
+        for (layout, offset) in [(&receiver, 0.0), (&source, strip.start(1))] {
+            for p in layout.placed_items().values() {
+                trial.place_item(p.item(), shift(p.d_transf(), offset));
+            }
+        }
+        self.clock.charge(Work::RegisteredItem, count as f64);
+        strip.set_blocker(&mut trial, shape)?;
+        let mut repair = Separator::new(trial, self.rng.next_u64(), EXPLORE, self.clock.clone());
+        repair.pin(blocker_index(self.model));
+        repair.region = Rect::try_new(0.0, 0.0, strip.width(shape), strip.height()).ok();
+        let (snapshot, tracker) = repair.separate(&self.deadline(self.last_step(until)));
+        if self.clock.now() >= self.last_step(until) {
+            self.stats.joint_repair_expired += 1;
+            return Ok(None);
+        }
+        if tracker.total_loss() > 0.0 {
+            self.stats.joint_repair_failed += 1;
+            return Ok(None);
+        }
+        let repaired = JLayout::from_snapshot(&snapshot);
+        let mut outputs = [
+            JLayout::new(strip.container(Shape {
+                sheets: 1,
+                last: self.model.full_width,
+            })?),
+            JLayout::new(strip.container(Shape { sheets: 1, last })?),
+        ];
+        for p in repaired
+            .placed_items()
+            .values()
+            .filter(|p| !strip.is_blocker(p))
+        {
+            let index = strip.sheet_of(p.shape());
+            if index >= 2 {
+                self.stats.joint_repair_failed += 1;
+                return Ok(None);
+            }
+            outputs[index].place_item(p.item(), shift(p.d_transf(), -strip.start(index)));
+        }
+        self.clock.charge(Work::RegisteredItem, count as f64);
+        // A thin end sliver may have no stable blocker. Validate both actual
+        // single-sheet containers, including the original source crop, before
+        // returning any repair. These constructors charge their geometry work.
+        let [receiver, source] = outputs;
+        let receiver = Separator::new(receiver, 0, EXPLORE, self.clock.clone());
+        let source = Separator::new(source, 0, EXPLORE, self.clock.clone());
+        if self.clock.now() >= self.last_step(until) {
+            self.stats.joint_repair_expired += 1;
+            return Ok(None);
+        }
+        if receiver.tracker.total_loss() > 0.0 || source.tracker.total_loss() > 0.0 {
+            self.stats.joint_repair_failed += 1;
+            return Ok(None);
+        }
+        // Repair can migrate an obstruction yet leave a source part raised.
+        // With both output inventories already valid in their exact containers,
+        // lower source members into free space without changing their poses'
+        // rotation/reflection, membership or the original phase deadline.
+        let mut source = source;
+        let mut keys: Vec<_> = source.layout.placed_items().keys().collect();
+        rank_incoming(&source.layout, &mut keys);
+        for key in keys {
+            if self.clock.now() >= self.last_step(until) {
+                break;
+            }
+            let placed = source.layout.remove_item(key);
+            let item = placed.item().clone();
+            let pose = free_return_pose(
+                &source.layout,
+                &item,
+                placed.d_transf(),
+                &self.clock,
+                self.last_step(until),
+            );
+            source.layout.place_item(&item, pose);
+            self.clock.charge(Work::RegisteredItem, 2.0);
+        }
+        source.rebuild();
+        if self.clock.now() >= self.last_step(until) {
+            self.stats.joint_repair_expired += 1;
+            return Ok(None);
+        }
+        if source.tracker.total_loss() > 0.0 {
+            self.stats.joint_repair_failed += 1;
+            return Ok(None);
+        }
+        self.stats.joint_repair_completed += 1;
+        Ok(Some([receiver.layout.save(), source.layout.save()]))
+    }
