+    fn joint_pair_exercise(
+        job: &Job,
+        layout: &Layout,
+        proposal: &Layout,
+        options: JointProbe,
+    ) -> (bool, Layout, Stats) {
+        let report = validate(job, layout).unwrap();
+        assert!(report.valid);
+        let model = Model::new(job).unwrap();
+        let clock = Clock::new(Timing::Work, 60.0);
+        let mut search = Search {
+            model: &model,
+            allow_exchange: options.enabled,
+            rng: Xoshiro256PlusPlus::seed_from_u64(0),
+            clock: clock.clone(),
+            best: (layout.clone(), report, 0.0),
+            history: vec![],
+            stats: Stats::default(),
+            progress: |_: &Progress, _: &dyn Fn() -> Option<Layout>| {},
+            check_cost: 0.0,
+            check_every: 5.0,
+        };
+        let strip = Strip {
+            model: &model,
+            gap: 2.0,
+            clock: clock.clone(),
+            containers: Default::default(),
+        };
+        let sheets = model.sheets_of(layout).unwrap();
+        let proposed = model.sheets_of(proposal).unwrap();
+        let (frozen, window) = sheets.split_at(1);
+        let mut shape = Shape {
+            sheets: window.len(),
+            last: model.full_width,
+        };
+        let whole = strip.layout(window, shape).unwrap();
+        shape.last = strip.fit_last(&whole, shape);
+        let before = search
+            .exchange_layout(&strip, frozen, &whole, shape)
+            .unwrap();
+        let original = fingerprint(&whole);
+        let last = options.last.unwrap_or(shape.last);
+        let receiver = JLayout::from_snapshot(&proposed[1].layout().save());
+        let source = JLayout::from_snapshot(&proposed.last().unwrap().layout().save());
+        let until = if options.budget <= 0.0 {
+            0.0
+        } else {
+            clock.now() + options.budget
+        };
+        let repaired = search
+            .joint_repair_pair(&strip, receiver, source, last, until)
+            .unwrap();
+        let mut trial = JLayout::from_snapshot(&whole.save());
+        let success = repaired.is_some();
+        if let Some(snapshots) = repaired {
+            let keys: Vec<_> = trial
+                .placed_items()
+                .iter()
+                .filter(|(_, p)| {
+                    !strip.is_blocker(p)
+                        && [0, shape.sheets - 1].contains(&strip.sheet_of(p.shape()))
+                })
+                .map(|(k, _)| k)
+                .collect();
+            for key in keys {
+                trial.remove_item(key);
+            }
+            for (snapshot, index) in snapshots.into_iter().zip([0, shape.sheets - 1]) {
+                let local = JLayout::from_snapshot(&snapshot);
+                for p in local.placed_items().values() {
+                    trial.place_item(p.item(), shift(p.d_transf(), strip.start(index)));
+                }
+            }
+        } else {
+            assert_eq!(fingerprint(&trial), original);
+        }
+        assert_eq!(
+            fingerprint(&whole),
+            original,
+            "Helper cannot mutate the incumbent"
+        );
+        let after = search
+            .exchange_layout(&strip, frozen, &trial, shape)
+            .unwrap();
+        let after_report = validate(job, &after).unwrap();
+        eprintln!(
+            "JOINT_PAIR_WITNESS {}",
+            serde_json::json!({"job":job,"before":before,"proposal":proposal,
+            "after":after,"success":success,"enabled":options.enabled,"budget":options.budget,"source_last":last,
+            "until":until,"finished":clock.now(),"valid":after_report.valid,"stats":search.stats,"work":clock.counts()})
+        );
+        assert!(after_report.valid);
+        for i in 0..sheets.len() {
+            if i == 1 || i == sheets.len() - 1 {
+                continue;
+            }
+            let id = format!("sheet-{i}");
+            assert_eq!(
+                serde_json::to_value(
+                    before
+                        .placements
+                        .iter()
+                        .filter(|p| p.sheet_id == id)
+                        .collect::<Vec<_>>()
+                )
+                .unwrap(),
+                serde_json::to_value(
+                    after
+                        .placements
+                        .iter()
+                        .filter(|p| p.sheet_id == id)
+                        .collect::<Vec<_>>()
+                )
+                .unwrap()
+            );
+        }
+        (success, after, search.stats)
+    }
