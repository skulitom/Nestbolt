+    // BEGIN joint-repair witness: original runtime, authored overlapping proposal
+    #[test]
+    fn joint_repair_existing_separator_can_change_the_source_assignment() {
+        let (mut job, mut layout) = fixture();
+        job.name = "Joint window permits an extra source member to migrate".into();
+        job.parts = vec![
+            rectangle("prefix", 96.0, 94.0),
+            rectangle("filler", 20.0, 94.0),
+            rectangle("return", 60.0, 85.0),
+            rectangle("incoming", 30.0, 94.0),
+            rectangle("extra", 40.0, 50.0),
+        ];
+        layout.sheets = (0..3)
+            .map(|i| Sheet {
+                id: format!("sheet-{i}"),
+                stock_id: "stock".into(),
+            })
+            .collect();
+        layout.placements = [
+            ("prefix", 0, [2.0, 2.0]),
+            ("filler", 1, [78.0, 2.0]),
+            ("return", 1, [2.0, 2.0]),
+            ("incoming", 2, [2.0, 2.0]),
+            ("extra", 2, [34.0, 2.0]),
+        ]
+        .into_iter()
+        .map(|(id, sheet, translation)| Placement {
+            part_id: id.into(),
+            copy_index: 0,
+            sheet_id: format!("sheet-{sheet}"),
+            transform: RigidTransform {
+                translation,
+                ..Default::default()
+            },
+        })
+        .collect();
+        assert!(validate(&job, &layout).unwrap().valid);
+        let mut proposed = layout.clone();
+        for p in &mut proposed.placements {
+            if p.part_id == "incoming" {
+                p.sheet_id = "sheet-1".into();
+            }
+            if p.part_id == "return" {
+                p.sheet_id = "sheet-2".into();
+            }
+        }
+        assert!(!validate(&job, &proposed).unwrap().valid);
+        // Two unrotated rectangles can avoid overlap only by separation along
+        // at least one axis. Even the full usable sheet is too small on both
+        // axes for this source inventory; its cropped prefix is no larger.
+        let usable = 100.0 - 2.0 * job.edge_clearance;
+        assert!(60.0 + 40.0 + job.clearance > usable);
+        assert!(85.0 + 50.0 + job.clearance > usable);
+        let mut authored = proposed.clone();
+        authored
+            .placements
+            .iter_mut()
+            .find(|p| p.part_id == "extra")
+            .unwrap()
+            .sheet_id = "sheet-1".into();
+        let hand_report = validate(&job, &authored).unwrap();
+        assert!(hand_report.valid);
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let proposed_sheets = model.sheets_of(&proposed).unwrap();
+        let clock = Clock::new(Timing::Work, 60.0);
+        let strip = Strip {
+            model: &model,
+            gap: 2.0,
+            clock: clock.clone(),
+            containers: Default::default(),
+        };
+        let (frozen, window) = sheets.split_at(1);
+        let mut shape = Shape {
+            sheets: window.len(),
+            last: model.full_width,
+        };
+        let initial = strip.layout(window, shape).unwrap();
+        shape.last = strip.fit_last(&initial, shape);
+        let mut before_sheets = frozen.to_vec();
+        before_sheets.extend(strip.split(&initial, shape.sheets).unwrap());
+        let before = model.to_layout(&before_sheets);
+        let before_report = validate(&job, &before).unwrap();
+        assert!(before_report.valid);
+        let seed = strip.layout(&proposed_sheets[1..], shape).unwrap();
+        let mut seed_sheets = frozen.to_vec();
+        seed_sheets.extend(strip.split(&seed, shape.sheets).unwrap());
+        let proposed_public = model.to_layout(&seed_sheets);
+        let mut source = JLayout::new(
+            strip
+                .container(Shape {
+                    sheets: 1,
+                    last: shape.last,
+                })
+                .unwrap(),
+        );
+        for p in seed
+            .placed_items()
+            .values()
+            .filter(|p| !strip.is_blocker(p) && strip.sheet_of(p.shape()) == 1)
+        {
+            source.place_item(p.item(), shift(p.d_transf(), -strip.start(1)));
+        }
+        assert_eq!(source.placed_items().len(), 2);
+        let source_clock = Clock::new(Timing::Work, 60.0);
+        let mut source_sep = Separator::new(source, 0, EXPLORE, source_clock.clone());
+        let source_start = source_clock.now();
+        let source_until = source_start + 12.0;
+        let (source_snapshot, source_tracker) = source_sep.separate(&crate::clock::Deadline {
+            clock: source_clock.clone(),
+            at: source_until,
+        });
+        let source_after = free_return_public(
+            &model,
+            &proposed_public,
+            &JLayout::from_snapshot(&source_snapshot),
+            "sheet-2",
+        );
+        let source_report = validate(&job, &source_after).unwrap();
+        eprintln!(
+            "JOINT_REPAIR_SOURCE_WITNESS {}",
+            serde_json::json!({"job":job,"before":before,"proposal":proposed_public,
+            "after":source_after,"loss":source_tracker.total_loss(),"started":source_start,"until":source_until,
+            "finished":source_clock.now(),"work":source_clock.counts(),"valid":source_report.valid})
+        );
+        assert!(source_tracker.total_loss() > 0.0 && !source_report.valid);
+        let mut joint = Separator::new(seed, 0, EXPLORE, clock.clone());
+        joint.pin(blocker_index(&model));
+        joint.region = Rect::try_new(0.0, 0.0, strip.width(shape), strip.height()).ok();
+        assert!(joint.tracker.total_loss() > 0.0);
+        let joint_start = clock.now();
+        let until = joint_start + 12.0;
+        let (snapshot, tracker) = joint.separate(&crate::clock::Deadline {
+            clock: clock.clone(),
+            at: until,
+        });
+        let mut after_sheets = frozen.to_vec();
+        after_sheets.extend(
+            strip
+                .split(&JLayout::from_snapshot(&snapshot), shape.sheets)
+                .unwrap(),
+        );
+        let after = model.to_layout(&after_sheets);
+        let report = validate(&job, &after).unwrap();
+        eprintln!(
+            "JOINT_REPAIR_WITNESS {}",
+            serde_json::json!({"job":job,"before":before,"proposal":proposed_public,
+            "authored_feasible":authored,"after":after,"loss":tracker.total_loss(),"started":joint_start,
+            "until":until,"finished":clock.now(),"work":clock.counts(),"valid":report.valid,"metrics":report.metrics,
+            "source_only_loss":source_tracker.total_loss(),"fixed_prefix_sheets":1,"seed":0})
+        );
+        assert_eq!(
+            tracker.total_loss(),
+            0.0,
+            "Joint repair must find an actual valid rearrangement"
+        );
+        assert!(report.valid && clock.now() < until);
+        assert!(
+            report.metrics.unwrap().material_area < before_report.metrics.unwrap().material_area,
+            "A valid return to the original arrangement does not prove useful joint repair"
+        );
+        assert_eq!(
+            after
+                .placements
+                .iter()
+                .find(|p| p.part_id == "extra")
+                .unwrap()
+                .sheet_id,
+            "sheet-1"
+        );
+        assert_eq!(
+            serde_json::to_value(
+                before
+                    .placements
+                    .iter()
+                    .filter(|p| p.sheet_id == "sheet-0")
+                    .collect::<Vec<_>>()
+            )
+            .unwrap(),
+            serde_json::to_value(
+                after
+                    .placements
+                    .iter()
+                    .filter(|p| p.sheet_id == "sheet-0")
+                    .collect::<Vec<_>>()
+            )
+            .unwrap()
+        );
+    }
+    // END joint-repair witness
+    fn joint_policy_exercise(
+        job: &Job,
+        layout: &Layout,
+        seed: u64,
+        enabled: bool,
+        phase: (f64, f64, u8),
+        frozen_count: usize,
+    ) -> (usize, Layout, Stats) {
+        let (short_budget, budget, mode) = phase;
+        let validation = validate(job, layout).unwrap();
+        assert!(validation.valid, "{:?}", validation.violations);
+        let model = Model::new(job).unwrap();
+        let clock = Clock::new(Timing::Work, 30.0);
+        let mut search = Search {
+            model: &model,
+            allow_exchange: enabled,
+            rng: Xoshiro256PlusPlus::seed_from_u64(seed),
+            clock: clock.clone(),
+            best: (layout.clone(), validation, 0.0),
+            history: vec![],
+            stats: Stats::default(),
+            progress: |_: &Progress, _: &dyn Fn() -> Option<Layout>| {},
+            check_cost: 0.0,
+            check_every: 5.0,
+        };
+        let strip = Strip {
+            model: &model,
+            gap: 2.0,
+            clock,
+            containers: Default::default(),
+        };
+        let sheets = model.sheets_of(layout).unwrap();
+        let (frozen, window) = sheets.split_at(frozen_count);
+        let mut shape = Shape {
+            sheets: window.len(),
+            last: model.full_width,
+        };
+        let initial = strip.layout(window, shape).unwrap();
+        shape.last = strip.fit_last(&initial, shape);
+        let mut sep = Separator::new(
+            strip.layout(window, shape).unwrap(),
+            seed,
+            EXPLORE,
+            search.clock.clone(),
+        );
+        sep.pin(blocker_index(&model));
+        assert_eq!(sep.tracker.total_loss(), 0.0);
+        // Compare the same f32 internal frame before/after the exchange. The
+        // public-to-internal conversion predates this operation and has its own
+        // tests; comparing to the authored f64 coordinates conflates the two.
+        let mut before_sheets = frozen.to_vec();
+        before_sheets.extend(strip.split(&sep.layout, shape.sheets).unwrap());
+        let before_layout = model.to_layout(&before_sheets);
+        let before_report = validate(job, &before_layout).unwrap();
+        assert!(before_report.valid);
+        let before_material = before_report.metrics.as_ref().unwrap().material_area;
+        let original = fingerprint(&sep.layout);
+        let until = if budget <= 0.0 {
+            0.0
+        } else {
+            search.clock.now() + budget
+        };
+        let short_until = if short_budget <= 0.0 {
+            0.0
+        } else {
+            search.clock.now() + short_budget
+        };
+        let mut fast_layout = None;
+        let moved = match mode {
+            0 => search
+                .joint_exchange_window(&strip, frozen, &mut sep, shape, short_until, until)
+                .unwrap(),
+            1 => search
+                .joint_exchange_chain(&strip, frozen, &mut sep, shape, until, 0)
+                .unwrap(),
+            3 => search
+                .joint_exchange_chain(&strip, frozen, &mut sep, shape, until, 3)
+                .unwrap(),
+            2 => {
+                let accepted = search
+                    .directed_exchange_chain(&strip, frozen, &mut sep, shape, short_until)
+                    .unwrap();
+                assert!(accepted > 0);
+                let fingerprint_before = fingerprint(&sep.layout);
+                fast_layout = Some(
+                    search
+                        .exchange_layout(&strip, frozen, &sep.layout, shape)
+                        .unwrap(),
+                );
+                let expired = search.clock.now();
+                let extra = search
+                    .joint_exchange_chain(&strip, frozen, &mut sep, shape, expired, accepted)
+                    .unwrap();
+                assert_eq!(extra, 0);
+                assert_eq!(fingerprint(&sep.layout), fingerprint_before);
+                accepted
+            }
+            _ => unreachable!(),
+        };
+        if moved == 0 {
+            assert_eq!(
+                fingerprint(&sep.layout),
+                original,
+                "failed proposal mutated the original state"
+            );
+        }
+        let mut after_sheets = frozen.to_vec();
