+    // BEGIN contained-return tests
+    fn return_seed_members(source: &JLayout) -> Vec<IncomingMember> {
+        source
+            .placed_items()
+            .iter()
+            .take(2)
+            .map(|(key, p)| (key, p.item().clone(), p.d_transf()))
+            .collect()
+    }
+
+    fn return_seed_bounds(members: &[IncomingMember], poses: &[DTransformation]) -> Rect {
+        assert_eq!(members.len(), poses.len());
+        assert!(!members.is_empty());
+        let mut x0 = f32::INFINITY;
+        let mut y0 = f32::INFINITY;
+        let mut x1 = f32::NEG_INFINITY;
+        let mut y1 = f32::NEG_INFINITY;
+        for ((_, item, _), pose) in members.iter().zip(poses) {
+            let mut shape = item.shape_cd().as_ref().clone();
+            shape.transform_from(item.shape_cd(), &pose.compose());
+            let b = shape.bbox();
+            x0 = x0.min(b.x_min);
+            y0 = y0.min(b.y_min);
+            x1 = x1.max(b.x_max);
+            y1 = y1.max(b.y_max);
+        }
+        Rect::try_new(x0, y0, x1, y1).unwrap()
+    }
+
+    fn return_seed_pose_bits(poses: &[DTransformation]) -> Vec<([u32; 3], bool)> {
+        poses
+            .iter()
+            .map(|p| {
+                let (x, y) = p.translation();
+                (
+                    [p.rotation().to_bits(), x.to_bits(), y.to_bits()],
+                    p.reflected,
+                )
+            })
+            .collect()
+    }
+
+    #[test]
+    fn contained_return_moves_fitting_group_inside_and_charges_all_transforms() {
+        let (job, layout) = boundary_pair_fixture(false);
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let members = return_seed_members(sheets[1].layout());
+        let mut poses = vec![
+            DTransformation::new(0.0, (20.0, 120.0)),
+            DTransformation::new(0.0, (50.0, 120.0)),
+        ];
+        let before = poses.clone();
+        let bounds = Rect::try_new(0.0, 0.0, 100.0, 100.0).unwrap();
+        assert!(return_seed_bounds(&members, &poses).y_max > bounds.y_max);
+        let clock = Clock::new(Timing::Work, 120.0);
+        assert!(
+            contain_return_group(&members, &mut poses, &bounds, &clock),
+            "Fitting returned group must be moved inside"
+        );
+        let b = return_seed_bounds(&members, &poses);
+        assert!(
+            b.x_min >= bounds.x_min
+                && b.y_min >= bounds.y_min
+                && b.x_max <= bounds.x_max
+                && b.y_max <= bounds.y_max
+        );
+        for (old, new) in before.iter().zip(&poses) {
+            assert_eq!(old.rotation().to_bits(), new.rotation().to_bits());
+            assert_eq!(old.reflected, new.reflected);
+            assert_eq!(old.translation().0.to_bits(), new.translation().0.to_bits());
+        }
+        assert_eq!(poses[1].translation().0 - poses[0].translation().0, 30.0);
+        assert_eq!(poses[1].translation().1, poses[0].translation().1);
+        assert_eq!(
+            clock.counts().evaluations,
+            4.0,
+            "Both original and proposed member bounds must be charged"
+        );
+        assert!(clock.counts().evaluated_vertices > 0.0 && clock.work() > 0.0);
+        eprintln!(
+            "CONTAINED_RETURN_WITNESS {}",
+            serde_json::json!({"job":job,
+            "source_layout":model.to_layout(&sheets),"bounds":[bounds.x_min,bounds.y_min,bounds.x_max,bounds.y_max],
+            "before":members.iter().zip(&before).map(|((_,item,_),p)|serde_json::json!({"part_id":job.parts[model.part[item.idx()]].id,"transform":model.external(item.idx(),p)})).collect::<Vec<_>>(),
+            "after":members.iter().zip(&poses).map(|((_,item,_),p)|serde_json::json!({"part_id":job.parts[model.part[item.idx()]].id,"transform":model.external(item.idx(),p)})).collect::<Vec<_>>(),
+            "work":clock.counts()})
+        );
+    }
