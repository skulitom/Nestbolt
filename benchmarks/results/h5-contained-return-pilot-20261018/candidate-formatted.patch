+// Bounds work is charged both for the original seed and any proposed shift.
+// The existing separator and whole-job validator still decide feasibility.
+fn return_group_bounds(
+    victims: &[IncomingMember],
+    poses: &[DTransformation],
+    clock: &Clock,
+) -> Option<Rect> {
+    let mut x0 = f32::INFINITY;
+    let mut y0 = f32::INFINITY;
+    let mut x1 = f32::NEG_INFINITY;
+    let mut y1 = f32::NEG_INFINITY;
+    for ((_, item, _), pose) in victims.iter().zip(poses) {
+        let mut shape = item.shape_cd().as_ref().clone();
+        shape.transform_from(item.shape_cd(), &pose.compose());
+        crate::separate::charge(clock, item, 1);
+        let bounds = shape.bbox();
+        if ![bounds.x_min, bounds.y_min, bounds.x_max, bounds.y_max]
+            .into_iter()
+            .all(f32::is_finite)
+        {
+            return None;
+        }
+        x0 = x0.min(bounds.x_min);
+        y0 = y0.min(bounds.y_min);
+        x1 = x1.max(bounds.x_max);
+        y1 = y1.max(bounds.y_max);
+    }
+    Rect::try_new(x0, y0, x1, y1).ok()
+}
