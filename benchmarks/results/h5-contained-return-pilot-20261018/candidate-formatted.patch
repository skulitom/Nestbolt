+    #[test]
+    fn contained_return_preserves_mixed_member_orientations_and_reflection() {
+        let (mut job, layout) = boundary_pair_fixture(true);
+        for part in &mut job.parts {
+            part.allow_mirror = true;
+            part.rotations = Rotations::List {
+                degrees: vec![0.0, 90.0, 180.0, 270.0],
+            };
+        }
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let members = return_seed_members(sheets[1].layout());
+        assert!(!std::sync::Arc::ptr_eq(&members[0].1, &members[1].1));
+        let mut poses = vec![
+            DTransformation::new(0.0, (-30.0, 20.0)).with_reflection(true),
+            DTransformation::new(std::f32::consts::FRAC_PI_2, (-30.0, 50.0)),
+        ];
+        assert!(
+            members
+                .iter()
+                .zip(&poses)
+                .all(|((_, item, _), p)| item.allowed_orientations().allows(p))
+        );
+        let before = poses.clone();
+        let bounds = Rect::try_new(0.0, 0.0, 100.0, 100.0).unwrap();
+        let clock = Clock::new(Timing::Work, 120.0);
+        assert!(
+            contain_return_group(&members, &mut poses, &bounds, &clock),
+            "Permitted mixed group must keep its orientations while translating"
+        );
+        let b = return_seed_bounds(&members, &poses);
+        assert!(b.x_min >= 0.0 && b.y_min >= 0.0 && b.x_max <= 100.0 && b.y_max <= 100.0);
+        for ((old, new), (_, item, _)) in before.iter().zip(&poses).zip(&members) {
+            assert_eq!(old.rotation().to_bits(), new.rotation().to_bits());
+            assert_eq!(old.reflected, new.reflected);
+            assert_eq!(old.translation().1.to_bits(), new.translation().1.to_bits());
+            assert!(item.allowed_orientations().allows(new));
+        }
+        assert_eq!(poses[0].translation().0, poses[1].translation().0);
+        assert_eq!(poses[1].translation().1 - poses[0].translation().1, 30.0);
+    }
