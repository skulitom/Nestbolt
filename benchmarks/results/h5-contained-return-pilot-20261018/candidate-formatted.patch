+    #[test]
+    fn contained_return_empty_contained_and_oversized_groups_are_bitwise_unchanged() {
+        let (job, layout) = boundary_pair_fixture(false);
+        let model = Model::new(&job).unwrap();
+        let sheets = model.sheets_of(&layout).unwrap();
+        let members = return_seed_members(sheets[1].layout());
+        let original = vec![
+            DTransformation::new(0.0, (20.0, 30.0)),
+            DTransformation::new(0.0, (50.0, 30.0)),
+        ];
+        for bounds in [
+            Rect::try_new(0.0, 0.0, 100.0, 100.0).unwrap(),
+            Rect::try_new(0.0, 0.0, 1.0, 1.0).unwrap(),
+        ] {
+            let mut poses = original.clone();
+            let clock = Clock::new(Timing::Work, 120.0);
+            assert!(!contain_return_group(&members, &mut poses, &bounds, &clock));
+            assert_eq!(
+                return_seed_pose_bits(&poses),
+                return_seed_pose_bits(&original)
+            );
+        }
+        let mut empty = vec![];
+        let bounds = Rect::try_new(0.0, 0.0, 100.0, 100.0).unwrap();
+        let clock = Clock::new(Timing::Work, 120.0);
+        assert!(!contain_return_group(&[], &mut empty, &bounds, &clock));
+        assert!(empty.is_empty());
+        assert_eq!(clock.work(), 0.0);
+    }
