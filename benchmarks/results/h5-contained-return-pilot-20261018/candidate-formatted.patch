+// Shift a fitting return seed as a whole into the existing source box.
+// Already contained, oversized, malformed or numerically uncontained results
+// retain the original seed exactly. Translation leaves permissions intact;
+// no random samples, deadline extensions or acceptance changes are introduced.
+fn contain_return_group(
+    victims: &[IncomingMember],
+    poses: &mut [DTransformation],
+    bounds: &Rect,
+    clock: &Clock,
+) -> bool {
+    if victims.is_empty() || victims.len() > 3 || victims.len() != poses.len() {
+        return false;
+    }
+    let Some(before) = return_group_bounds(victims, poses, clock) else {
+        return false;
+    };
+    if before.x_max - before.x_min > bounds.x_max - bounds.x_min
+        || before.y_max - before.y_min > bounds.y_max - bounds.y_min
+    {
+        return false;
+    }
+    let correction = |low: f32, high: f32, min: f32, max: f32| {
+        // Place the seed just inside instead of exactly on a rounded edge.
+        // The final box check remains exact; this is a real translation,
+        // never a relaxed geometry tolerance. Limit it to half the free span.
+        let scale = low
+            .abs()
+            .max(high.abs())
+            .max(min.abs())
+            .max(max.abs())
+            .max(1.0);
+        let room = ((max - min) - (high - low)).max(0.0);
+        let inset = (4.0 * f32::EPSILON * scale).min(room * 0.5);
+        if low < min {
+            min - low + inset
+        } else if high > max {
+            max - high - inset
+        } else {
+            0.0
+        }
+    };
+    let dx = correction(before.x_min, before.x_max, bounds.x_min, bounds.x_max);
+    let dy = correction(before.y_min, before.y_max, bounds.y_min, bounds.y_max);
+    if dx == 0.0 && dy == 0.0 {
+        return false;
+    }
+    let shifted: Vec<_> = poses
+        .iter()
+        .map(|pose| {
+            let (x, y) = pose.translation();
+            DTransformation::new(pose.rotation(), (x + dx, y + dy)).with_reflection(pose.reflected)
+        })
+        .collect();
+    let Some(after) = return_group_bounds(victims, &shifted, clock) else {
+        return false;
+    };
+    if after.x_min < bounds.x_min
+        || after.y_min < bounds.y_min
+        || after.x_max > bounds.x_max
+        || after.y_max > bounds.y_max
+    {
+        return false;
+    }
+    poses.copy_from_slice(&shifted);
+    true
 }
 
