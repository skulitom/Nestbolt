+    #[test]
+    fn return_reuse_restores_best_geometry_tracker_keys_and_rng() {
+        let (job, _) = fixture();
+        let model = Model::new(&job).unwrap();
+        let sheet = model.empty_sheet().unwrap();
+        let container = sheet.layout().container();
+        let clock = Clock::new(Timing::Work, 30.0);
+        let mut source = Separator::new(
+            return_repair_layout(&model, container, false),
+            7,
+            EXPLORE,
+            clock.clone(),
+        );
+        assert_eq!(source.tracker.total_loss(), 0.0);
+        let snapshot = source.layout.save();
+        let tracker = source.tracker.clone();
+        let fingerprint_before = fingerprint(&source.layout);
+        let keys: Vec<_> = source.layout.placed_items().keys().collect();
+        let pose = source.layout.placed_items()[keys[0]].d_transf();
+        let moved = source.move_item(keys[1], pose);
+        assert_ne!(keys[1], moved);
+        assert!(source.tracker.total_loss() > 0.0);
+        let expected_rng = source.rng.clone().next_u64();
+        let mut saved = None;
+        remember_return_repair(&mut saved, source, &snapshot, &tracker);
+        let fresh = Separator::new(
+            return_repair_layout(&model, container, true),
+            999,
+            EXPLORE,
+            clock,
+        );
+        let (mut resumed, reused) = resume_return_repair(&mut saved, fresh);
+        assert!(reused && saved.is_none());
+        assert_eq!(fingerprint(&resumed.layout), fingerprint_before);
+        assert_eq!(resumed.rng.next_u64(), expected_rng);
+        let rebuilt = crate::separate::Tracker::new(&resumed.layout);
+        assert_eq!(resumed.tracker.total_loss(), rebuilt.total_loss());
+        for key in resumed.layout.placed_items().keys() {
+            assert_eq!(resumed.tracker.loss(key), rebuilt.loss(key));
+        }
+    }
