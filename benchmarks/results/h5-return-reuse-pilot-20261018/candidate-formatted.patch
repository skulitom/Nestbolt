+    fn return_repair_layout(model: &Model<'_>, container: &Container, overlap: bool) -> JLayout {
+        let item = &model.instance.items[1].0;
+        let mut layout = JLayout::new(container.clone());
+        for (x, y) in [(25.0, 25.0), (if overlap { 25.0 } else { 65.0 }, 25.0)] {
+            let pose = convert_sample_to_closest_feasible(DTransformation::new(0.0, (x, y)), item);
+            assert!(item.allowed_orientations().allows(&pose));
+            layout.place_item(item, pose);
+        }
+        layout
+    }
