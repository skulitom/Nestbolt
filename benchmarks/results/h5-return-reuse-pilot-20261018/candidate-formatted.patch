+    #[test]
+    fn return_reuse_rejects_changed_counts_and_part_membership() {
+        let (job, _) = fixture();
+        let model = Model::new(&job).unwrap();
+        let sheet = model.empty_sheet().unwrap();
+        let container = sheet.layout().container();
+        let baseline = return_repair_layout(&model, container, false);
+        for replace in [false, true] {
+            let mut changed = JLayout::from_snapshot(&baseline.save());
+            let key = changed.placed_items().keys().next().unwrap();
+            let pose = changed.remove_item(key).d_transf();
+            if replace {
+                changed.place_item(&model.instance.items[2].0, pose);
+            }
+            let clock = Clock::new(Timing::Work, 30.0);
+            let mut saved = Some(Separator::new(
+                JLayout::from_snapshot(&baseline.save()),
+                0,
+                EXPLORE,
+                clock.clone(),
+            ));
+            let expected = fingerprint(&changed);
+            let (actual, reused) =
+                resume_return_repair(&mut saved, Separator::new(changed, 1, EXPLORE, clock));
+            assert!(!reused && saved.is_none());
+            assert_eq!(fingerprint(&actual.layout), expected);
+        }
+    }
