  "branch": "                    if exact_physical_state(&sep.layout, &trial) {\n                        self.stats.neutral_exchange_rejections += 1;\n                        self.stats.exact_state_exchange_rejections += 1;\n                        continue;\n                    }\n",
  "predicate": "// Conservative equality: exact bits and shared immutable model identity.\n// Ignore placement keys and order, retain multiplicity. A false result does\n// not prove changed geometry (e.g. -0 versus +0); true is conservative.\nfn exact_physical_state(a: &JLayout, b: &JLayout) -> bool {\n    use std::sync::Arc;\n    if !Arc::ptr_eq(a.container().base_cde(), b.container().base_cde())\n        || !Arc::ptr_eq(a.container().outer_orig(), b.container().outer_orig())\n        || !Arc::ptr_eq(a.container().outer_cd(), b.container().outer_cd())\n        || a.placed_items().len() != b.placed_items().len()\n    {\n        return false;\n    }\n    let keys = |layout: &JLayout| {\n        let mut keys: Vec<_> = layout\n            .placed_items()\n            .values()\n            .map(|p| {\n                let dt = p.d_transf();\n                let (x, y) = dt.translation();\n                (\n                    p.item().idx(),\n                    Arc::as_ptr(p.item()) as usize,\n                    [dt.rotation().to_bits(), x.to_bits(), y.to_bits()],\n                    dt.reflected,\n                )\n            })\n            .collect();\n        keys.sort_unstable();\n        keys\n    };\n    keys(a) == keys(b)\n}\n\n",
